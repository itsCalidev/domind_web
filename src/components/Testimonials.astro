---
const testimonials = [
  {
    id: 1,
    name: "María González",
    position: "Directora de Recursos Humanos",
    company: "TechCorp México",
    location: "Ciudad de México",
    rating: 5,
    text: "El diagnóstico organizacional nos permitió identificar áreas críticas que desconocíamos. La intervención fue profesional y los resultados tangibles en menos de 3 meses.",
    avatar: "MG"
  },
  {
    id: 2,
    name: "Carlos Hernández",
    position: "Gerente General",
    company: "Industrias del Pacífico",
    location: "Guadalajara, Jalisco",
    rating: 5,
    text: "Redujimos la rotación de personal en un 40% después de implementar las recomendaciones. El equipo de DOMIND entiende profundamente la realidad organizacional mexicana.",
    avatar: "CH"
  },
  {
    id: 3,
    name: "Ana Patricia Ruiz",
    position: "CEO",
    company: "Grupo Innovación",
    location: "Monterrey, Nuevo León",
    rating: 5,
    text: "Más que consultores, son verdaderos aliados estratégicos. Su enfoque basado en datos y su experiencia nos ayudaron a transformar completamente nuestra cultura organizacional.",
    avatar: "AR"
  },
  {
    id: 4,
    name: "Roberto Sánchez",
    position: "Director de Operaciones",
    company: "LogiTrans SA",
    location: "Querétaro",
    rating: 5,
    text: "Los accidentes laborales disminuyeron un 65% tras implementar el programa de seguridad. Inversión que se pagó sola en el primer año.",
    avatar: "RS"
  },
  {
    id: 5,
    name: "Laura Martínez",
    position: "Jefa de Talento Humano",
    company: "Retail Express",
    location: "Puebla",
    rating: 5,
    text: "El clima laboral mejoró notablemente. Pasamos de un índice de 2.3 a 3.8 en 6 meses. Nuestros colaboradores ahora recomiendan trabajar aquí.",
    avatar: "LM"
  }
];
---

<section class="py-16 md:py-24 bg-gradient-to-b from-white to-gray-50 overflow-hidden relative">
  <!-- Decorative elements -->
  <div class="absolute top-0 left-0 w-96 h-96 bg-blue-100 rounded-full filter blur-3xl opacity-20 -translate-x-1/2 -translate-y-1/2"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-purple-100 rounded-full filter blur-3xl opacity-20 translate-x-1/2 translate-y-1/2"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-8 animate-fade-in-up">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        Nuestros <span class="text-blue-900">Clientes</span>
      </h2>
      <div class="flex justify-center mb-6">
        <div class="w-24 h-1 bg-gradient-to-r from-transparent via-blue-900 to-transparent animate-pulse-slow"></div>
      </div>
      <p class="text-base md:text-lg text-gray-600 max-w-2xl mx-auto">
        Conoce las experiencias de organizaciones que han <span class="text-blue-900 font-semibold">transformado</span> su clima laboral y seguridad
      </p>
    </div>

    <!-- Desktop Carousel -->
    <div class="hidden lg:block relative px-16">
      <div class="relative h-[450px] overflow-visible">
        <div class="absolute inset-0 flex items-center justify-center">
          <div id="carousel-container" class="relative w-full max-w-5xl">
            {testimonials.map((testimonial, index) => (
              <div
                data-index={index}
                class="testimonial-card absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[420px] transition-all duration-700 ease-out"
                style="opacity: 0; transform: translate(-50%, -50%) scale(0.8);"
              >
                <div class="bg-white rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-300 p-8 border border-gray-100 relative overflow-hidden group">
                  <!-- Animated gradient overlay -->
                  <div class="absolute inset-0 bg-gradient-to-br from-blue-50/0 via-blue-50/50 to-purple-50/0 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                  
                  <div class="relative z-10">
                    <!-- Quote icon -->
                    <div class="absolute -top-2 -left-2 text-blue-900/10 transform -rotate-12 group-hover:rotate-0 transition-transform duration-500">
                      <svg class="w-16 h-16" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                      </svg>
                    </div>

                    <!-- Stars with stagger animation -->
                    <div class="flex gap-1 mb-6 mt-4">
                      {Array.from({ length: testimonial.rating }).map((_, i) => (
                        <svg 
                          class="star w-5 h-5 text-yellow-400 fill-current transform transition-all duration-300 hover:scale-125"
                          style={`animation-delay: ${i * 100}ms;`}
                          viewBox="0 0 20 20"
                        >
                          <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
                        </svg>
                      ))}
                    </div>

                    <!-- Quote text -->
                    <p class="text-gray-700 text-base leading-relaxed mb-6 min-h-[120px]">
                      "{testimonial.text}"
                    </p>

                    <!-- Author info -->
                    <div class="flex items-center gap-4 pt-6 border-t border-gray-100">
                      <div class="relative">
                        <div class="w-14 h-14 bg-gradient-to-br from-blue-900 to-blue-700 rounded-full flex items-center justify-center text-white font-bold text-base shadow-lg transform group-hover:scale-110 transition-transform duration-300">
                          {testimonial.avatar}
                        </div>
                        <div class="absolute -bottom-1 -right-1 w-5 h-5 bg-green-500 rounded-full border-2 border-white animate-pulse-dot"></div>
                      </div>
                      <div class="flex-1">
                        <p class="font-bold text-gray-900 text-base">{testimonial.name}</p>
                        <p class="text-sm text-gray-600">{testimonial.position}</p>
                        <div class="flex items-center gap-1 mt-1">
                          <svg class="w-3 h-3 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                          </svg>
                          <p class="text-xs text-gray-500">{testimonial.location}</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Navigation Arrows -->
      <button
        id="prev-btn"
        class="absolute left-0 top-1/2 -translate-y-1/2 w-14 h-14 bg-white hover:bg-blue-900 rounded-full shadow-xl flex items-center justify-center transition-all duration-300 hover:scale-110 group z-20"
        aria-label="Previous testimonial"
      >
        <svg class="w-6 h-6 text-gray-700 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button
        id="next-btn"
        class="absolute right-0 top-1/2 -translate-y-1/2 w-14 h-14 bg-white hover:bg-blue-900 rounded-full shadow-xl flex items-center justify-center transition-all duration-300 hover:scale-110 group z-20"
        aria-label="Next testimonial"
      >
        <svg class="w-6 h-6 text-gray-700 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Mobile/Tablet Carousel -->
    <div class="lg:hidden">
      <div class="relative">
        <div id="mobile-carousel" class="overflow-hidden">
          <div id="mobile-track" class="flex transition-transform duration-500 ease-out">
            {testimonials.map((testimonial) => (
              <div class="flex-shrink-0 w-full px-4">
                <div class="bg-white rounded-2xl shadow-xl p-6 sm:p-8 mx-auto max-w-md border border-gray-100">
                  <!-- Quote icon -->
                  <div class="text-blue-900/10 mb-4">
                    <svg class="w-12 h-12" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                    </svg>
                  </div>

                  <!-- Stars -->
                  <div class="flex gap-1 mb-4">
                    {Array.from({ length: testimonial.rating }).map(() => (
                      <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                        <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z" />
                      </svg>
                    ))}
                  </div>

                  <!-- Quote -->
                  <p class="text-gray-700 text-base leading-relaxed mb-6">
                    "{testimonial.text}"
                  </p>

                  <!-- Author -->
                  <div class="flex items-center gap-4 pt-4 border-t border-gray-100">
                    <div class="relative">
                      <div class="w-12 h-12 bg-gradient-to-br from-blue-900 to-blue-700 rounded-full flex items-center justify-center text-white font-bold text-sm shadow-lg">
                        {testimonial.avatar}
                      </div>
                      <div class="absolute -bottom-1 -right-1 w-4 h-4 bg-green-500 rounded-full border-2 border-white"></div>
                    </div>
                    <div>
                      <p class="font-bold text-gray-900 text-sm">{testimonial.name}</p>
                      <p class="text-xs text-gray-600">{testimonial.position}</p>
                      <p class="text-xs text-gray-500">{testimonial.location}</p>
                    </div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- Navigation Dots -->
    <div class="flex justify-center gap-2 mt-10">
      {testimonials.map((_, index) => (
        <button
          data-dot-index={index}
          class="dot w-2.5 h-2.5 rounded-full bg-gray-300 transition-all duration-300 hover:bg-blue-900"
          aria-label={`Go to testimonial ${index + 1}`}
        />
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  @keyframes pulseSlow {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  .animate-pulse-slow {
    animation: pulseSlow 3s ease-in-out infinite;
  }

  @keyframes pulseDot {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.7;
      transform: scale(1.1);
    }
  }

  .animate-pulse-dot {
    animation: pulseDot 2s ease-in-out infinite;
  }

  @keyframes starPop {
    from {
      opacity: 0;
      transform: scale(0) rotate(-180deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  .star {
    animation: starPop 0.5s ease-out forwards;
    opacity: 0;
  }

  .dot.active {
    background-color: #1e3a8a;
    width: 2rem;
    transform: scale(1.2);
  }

  .testimonial-card {
    pointer-events: none;
  }

  .testimonial-card.active {
    pointer-events: auto;
  }
</style>

<script>
  // Configuration
  const totalTestimonials = 5;
  let currentIndex = 0;
  let mobileIndex = 0;
  let isDesktop = window.innerWidth >= 1024;

  // Elements
  const cards = document.querySelectorAll('.testimonial-card') as NodeListOf<HTMLElement>;
  const dots = document.querySelectorAll('.dot');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const mobileTrack = document.getElementById('mobile-track');
  const mobileCarousel = document.getElementById('mobile-carousel');
  const carouselContainer = document.getElementById('carousel-container');

  // Desktop Carousel
  function updateDesktopCarousel() {
    cards.forEach((card, index) => {
      const diff = index - currentIndex;
      
      card.classList.remove('active');
      
      if (diff === 0) {
        // Center card
        card.style.transform = 'translate(-50%, -50%) scale(1.05)';
        card.style.opacity = '1';
        card.style.zIndex = '30';
        card.style.filter = 'blur(0px)';
        card.classList.add('active');
      } else if (diff === -1 || (currentIndex === 0 && index === totalTestimonials - 1)) {
        // Left card
        card.style.transform = 'translate(-50%, -50%) translateX(-450px) scale(0.85)';
        card.style.opacity = '0.4';
        card.style.zIndex = '10';
        card.style.filter = 'blur(1px)';
      } else if (diff === 1 || (currentIndex === totalTestimonials - 1 && index === 0)) {
        // Right card
        card.style.transform = 'translate(-50%, -50%) translateX(450px) scale(0.85)';
        card.style.opacity = '0.4';
        card.style.zIndex = '10';
        card.style.filter = 'blur(1px)';
      } else {
        // Hidden cards
        card.style.transform = 'translate(-50%, -50%) scale(0.7)';
        card.style.opacity = '0';
        card.style.zIndex = '0';
        card.style.filter = 'blur(2px)';
      }
    });

    // Animate stars on active card
    const activeCard = cards[currentIndex];
    const stars = activeCard?.querySelectorAll('.star');
    stars?.forEach((star, i) => {
      (star as HTMLElement).style.animation = 'none';
      setTimeout(() => {
        (star as HTMLElement).style.animation = `starPop 0.5s ease-out ${i * 100}ms forwards`;
      }, 10);
    });

    // Update dots
    updateDots(currentIndex);
  }

  function nextDesktopSlide() {
    currentIndex = (currentIndex + 1) % totalTestimonials;
    updateDesktopCarousel();
  }

  function prevDesktopSlide() {
    currentIndex = (currentIndex - 1 + totalTestimonials) % totalTestimonials;
    updateDesktopCarousel();
  }

  // Mobile Carousel
  function updateMobileCarousel() {
    if (mobileTrack) {
      (mobileTrack as HTMLElement).style.transform = `translateX(-${mobileIndex * 100}%)`;
    }
    updateDots(mobileIndex);
  }

  function nextMobileSlide() {
    mobileIndex = (mobileIndex + 1) % totalTestimonials;
    updateMobileCarousel();
  }

  function prevMobileSlide() {
    mobileIndex = (mobileIndex - 1 + totalTestimonials) % totalTestimonials;
    updateMobileCarousel();
  }

  // Dots update (unified)
  function updateDots(activeIndex: number) {
    dots.forEach((dot, index) => {
      if (index === activeIndex) {
        dot.classList.add('active');
      } else {
        dot.classList.remove('active');
      }
    });
  }

  // Event Listeners
  prevBtn?.addEventListener('click', () => {
    if (isDesktop) {
      prevDesktopSlide();
    }
  });

  nextBtn?.addEventListener('click', () => {
    if (isDesktop) {
      nextDesktopSlide();
    }
  });

  // Dots click
  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => {
      if (isDesktop) {
        currentIndex = index;
        updateDesktopCarousel();
      } else {
        mobileIndex = index;
        updateMobileCarousel();
      }
    });
  });

  // Touch/Swipe for mobile
  let touchStartX = 0;
  let touchEndX = 0;

  mobileCarousel?.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
  });

  mobileCarousel?.addEventListener('touchend', (e) => {
    touchEndX = e.changedTouches[0].screenX;
    const diff = touchStartX - touchEndX;
    
    if (Math.abs(diff) > 50) {
      if (diff > 0) {
        nextMobileSlide();
      } else {
        prevMobileSlide();
      }
    }
  });

  // Auto-play
  let desktopAutoplay: ReturnType<typeof setInterval>;
  let mobileAutoplay: ReturnType<typeof setInterval>;

  function startAutoplay() {
    if (isDesktop) {
      desktopAutoplay = setInterval(nextDesktopSlide, 5000);
    } else {
      mobileAutoplay = setInterval(nextMobileSlide, 5000);
    }
  }

  function stopAutoplay() {
    clearInterval(desktopAutoplay);
    clearInterval(mobileAutoplay);
  }

  // Pause on hover (desktop)
  carouselContainer?.addEventListener('mouseenter', () => {
    if (isDesktop) {
      stopAutoplay();
    }
  });

  carouselContainer?.addEventListener('mouseleave', () => {
    if (isDesktop) {
      stopAutoplay();
      startAutoplay();
    }
  });

  // Pause on touch (mobile)
  let touchTimeout: ReturnType<typeof setTimeout>;
  mobileCarousel?.addEventListener('touchstart', () => {
    if (!isDesktop) {
      stopAutoplay();
      clearTimeout(touchTimeout);
    }
  });

  mobileCarousel?.addEventListener('touchend', () => {
    if (!isDesktop) {
      touchTimeout = setTimeout(() => {
        startAutoplay();
      }, 1000);
    }
  });

  // Handle resize
  let resizeTimeout: ReturnType<typeof setTimeout>;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(() => {
      const wasDesktop = isDesktop;
      isDesktop = window.innerWidth >= 1024;
      
      if (wasDesktop !== isDesktop) {
        stopAutoplay();
        
        if (isDesktop) {
          // Sync indices
          currentIndex = mobileIndex;
          updateDesktopCarousel();
        } else {
          // Sync indices
          mobileIndex = currentIndex;
          updateMobileCarousel();
        }
        
        startAutoplay();
      }
    }, 250);
  });

  // Initialize
  function init() {
    isDesktop = window.innerWidth >= 1024;
    
    if (isDesktop) {
      updateDesktopCarousel();
    } else {
      updateMobileCarousel();
    }
    
    startAutoplay();
  }

  // Run initialization
  init();
</script>