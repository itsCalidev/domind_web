---
const clients = [
  { name: 'Jabil', logo: '/clients/jabil.webp' },
  { name: 'Peña Colorada', logo: '/clients/pena.png' },
  { name: 'Ternium', logo: '/clients/ternium.png' },
  { name: 'Avianca', logo: '/clients/avianca.png' },
  { name: 'BODESA', logo: '/clients/bodesa.png' },
  { name: 'Kiosko', logo: '/clients/kiosko.jpg' },
  { name: 'Grupo Cerritos', logo: '/clients/cerritos.png' },
  { name: 'NatureSweet', logo: '/clients/nature.avif' },
  { name: 'Tec de Monterrey', logo: '/clients/tec.png' },
  { name: 'Universidad de Colima', logo: '/clients/udc.png' },
  { name: 'Universidad de Guadalajara', logo: '/clients/udg.png' },
  { name: 'Nissan', logo: '/clients/nissan.webp' }
];
---

<section class="py-16 md:py-24 bg-gradient-to-b from-white to-gray-50 overflow-hidden relative">
  <!-- Decorative elements -->
  <div class="absolute top-0 left-0 w-96 h-96 bg-blue-100 rounded-full filter blur-3xl opacity-20 -translate-x-1/2 -translate-y-1/2"></div>
  <div class="absolute bottom-0 right-0 w-96 h-96 bg-purple-100 rounded-full filter blur-3xl opacity-20 translate-x-1/2 translate-y-1/2"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-16 animate-fade-in-up">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        Nuestros <span class="text-blue-900">Clientes</span>
      </h2>
      <div class="flex justify-center mb-6">
        <div class="w-24 h-1 bg-gradient-to-r from-transparent via-blue-900 to-transparent animate-pulse-slow"></div>
      </div>
      <p class="text-base md:text-lg text-gray-600 max-w-2xl mx-auto">
        Conoce las experiencias de organizaciones que han <span class="font-bold text-blue-900">transformado</span> su clima laboral y seguridad
      </p>
    </div>

    <!-- Logos Grid -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 md:gap-12 items-center justify-items-center mb-16">
      {clients.map((client, index) => (
        <div 
          class="client-logo group animate-fade-in-up"
          style={`animation-delay: ${index * 0.1}s`}
        >
          <div class="relative w-full h-24 flex items-center justify-center p-4 rounded-xl bg-white hover:bg-gray-50 transition-all duration-300 shadow-sm hover:shadow-md">
            <img 
              src={client.logo}
              alt={`Logo ${client.name}`}
              class="max-w-full max-h-full object-contain grayscale hover:grayscale-0 transition-all duration-300 opacity-60 hover:opacity-100"
            
            />
          </div>
          <p class="text-center text-xs text-gray-500 mt-2 font-medium opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            {client.name}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pulseSlow {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  .animate-pulse-slow {
    animation: pulseSlow 3s ease-in-out infinite;
  }

  .client-logo {
    width: 100%;
    max-width: 200px;
  }

  /* Asegurar que el filtro grayscale funcione en todos los navegadores */
  .grayscale {
    filter: grayscale(100%);
    -webkit-filter: grayscale(100%);
  }

  .grayscale:hover,
  .hover\:grayscale-0:hover {
    filter: grayscale(0%);
    -webkit-filter: grayscale(0%);
  }
</style>