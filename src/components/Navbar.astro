---

<nav class="bg-white shadow-sm fixed top-0 left-0 right-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16 md:h-20">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/" class="block">
          <!-- 
            Manual de Marca:
            x = Altura de la O mayúscula
            35x = Ancho total
            8x = Alto total
            Proporción: 35:8 = 4.375:1
          -->
          <img 
            src="src/assets/logo.png" 
            alt="DOMIND" 
            class="h-8 md:h-10 w-auto"
            style="width: auto; height: 8rem;"
          />
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-6 lg:space-x-8">
        <a href="#linkedin" class="text-gray-600 hover:text-gray-900 font-medium transition-colors">
          Linkedin
        </a>
        <a href="#podcast" class="text-gray-600 hover:text-gray-900 font-medium transition-colors">
          Podcast
        </a>
        <a href="#newsletter" class="text-gray-600 hover:text-gray-900 font-medium transition-colors">
          Newsletter
        </a>
        <button class="p-2 text-gray-600 hover:text-gray-900 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <div class="md:hidden">
        <button class="p-2 text-gray-600 hover:text-gray-900">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>