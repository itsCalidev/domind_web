---
---

<nav id="navbar" class="fixed top-4 left-1/2 -translate-x-1/2 z-50 transition-all duration-300 w-full max-w-6xl px-4">
  <div id="navbar-content" class="bg-transparent backdrop-blur-sm rounded-2xl shadow-none border border-transparent px-6 py-3 transition-all duration-300">
    <div class="flex justify-between items-center">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a href="/" class="block">
          <img 
            src="src/assets/logo.png" 
            alt="DOMIND" 
            class="h-10 w-auto transition-all duration-300"
            style="width: auto; height: 3rem;"
            id="logo"
          />
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-6 lg:space-x-8">
        <a href="https://www.linkedin.com/in/domind/" target="_blank" rel="noopener noreferrer" class="text-gray-700 hover:text-blue-900 font-medium transition-colors">
          Linkedin
        </a>
        <a href="#podcast" class="text-gray-700 hover:text-blue-900 font-medium transition-colors">
          Podcast
        </a>
        <a href="#newsletter" class="text-gray-700 hover:text-blue-900 font-medium transition-colors">
          Newsletter
        </a>
        <button class="p-2 text-gray-700 hover:text-blue-900 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <div class="md:hidden">
        <button id="mobile-menu-btn" class="p-2 text-gray-700 hover:text-blue-900">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>

<script>
  // Navbar scroll behavior
  const navbar = document.getElementById('navbar');
  const navbarContent = document.getElementById('navbar-content');
  const logo = document.getElementById('logo');

  window.addEventListener('scroll', () => {
    const currentScroll = window.pageYOffset;
    
    if (currentScroll <= 100) {
      // At top - transparent floating state
      navbar?.classList.remove('top-0', 'max-w-full', 'px-0');
      navbar?.classList.add('top-4', 'max-w-6xl', 'px-4');
      
      navbarContent?.classList.remove('bg-white/90', 'shadow-lg', 'border-gray-200/50');
      navbarContent?.classList.add('bg-transparent', 'shadow-none', 'border-transparent');
      
      logo?.classList.remove('h-8');
      logo?.classList.add('h-10');
    } else {
      // Scrolled - white full width sticky
      navbar?.classList.remove('top-4', 'max-w-6xl', 'px-4');
      navbar?.classList.add('top-0', 'max-w-full', 'px-0');
      
      navbarContent?.classList.remove('bg-transparent', 'shadow-none', 'border-transparent');
      navbarContent?.classList.add('bg-white/90', 'shadow-lg', 'border-gray-200/50');
      
      logo?.classList.remove('h-10');
      logo?.classList.add('h-8');
    }
  });
</script>