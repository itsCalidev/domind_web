---

---

<section
  class="relative bg-gradient-to-br from-gray-100 to-gray-200 pt-24 md:pt-32 pb-16 md:pb-24 overflow-hidden"
>
  <!-- Background Pattern Overlay -->
  <div
    class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-30"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto">

      <!-- Main Heading -->
      <div
        class="mb-8 md:mb-12 shadow-lg bg-white-80 rounded-lg opacity-90 p-1 md:p-1"
      >
        <h1
          class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-gray-900 leading-tight mb-6 md:mb-8"
        >
          De <span class="text-blue-900 font-bold">Síntomas</span> a Transformación
          Organizacional
        </h1>
      </div>


      <!-- Subtitle -->

      <p
        class="text-base sm:text-lg md:text-xl text-gray-600 mb-8 md:mb-10 max-w-3xl mx-auto leading-relaxed"
      >
        <span class="font-bold">Diagnóstico gratuito </span> de clima laboral, seguridad y bienestar para
        identificar riesgos y activar soluciones.
      </p>

      <!-- CTA Buttons -->
      <div
        class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-8 md:mb-12"
      >
        <button
          class="w-full sm:w-auto px-8 py-3.5 bg-blue-900 hover:bg-blue-800 text-white font-semibold rounded-lg shadow-lg transition-all duration-200 transform hover:scale-105"
        >
        
           <a href="/diagnostico">Realizar Diagnóstico Gratuito</a>

        </button>
        <button
          class="w-full sm:w-auto px-8 py-4 bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold rounded-lg shadow-md border border-gray-300 transform hover:scale-105 transition-all duration-200"
        >
          Conocer los Workshops
        </button>
      </div>

      <!-- Experience Badge -->
      <p class="text-base md:text-lg text-gray-600 font-medium">
        Más de <span class="font-bold">25 años</span> de experiencia en transformación organizacional en
        Latinoamérica
      </p>
    </div>
  </div>
</section>
