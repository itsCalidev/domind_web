---

---

<section
  class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden bg-gradient-to-br from-gray-50 via-blue-50/30 to-gray-100 pt-24"
>
  <!-- Animated background grid -->
  <div class="absolute inset-0 bg-grid-pattern opacity-[0.03]"></div>

  <!-- Decorative animated blobs -->
  <div
    class="absolute top-20 left-10 w-72 h-72 bg-blue-400/20 rounded-full blur-3xl animate-blob"
  >
  </div>
  <div
    class="absolute top-40 right-10 w-96 h-96 bg-purple-400/20 rounded-full blur-3xl animate-blob animation-delay-2000"
  >
  </div>
  <div
    class="absolute -bottom-20 left-1/2 w-96 h-96 bg-blue-300/20 rounded-full blur-3xl animate-blob animation-delay-4000"
  >
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <!-- Main Content Grid -->
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left Content -->
      <div class="text-center lg:text-left space-y-8 z-10">
        <!-- Main Heading with fade-in animation -->
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold leading-tight animate-fade-in-up"
        >
          De Problemas a <span class="text-blue-900 relative inline-block">
            Soluciones
            <svg
              class="absolute -bottom-2 left-0 w-full"
              height="12"
              viewBox="0 0 200 12"
              fill="none"
            >
              <path
                d="M2 10C50 2, 150 2, 198 10"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                class="text-blue-900/40"></path>
            </svg>
          </span>
        </h1>

        <!-- Subtitle -->
        <p
          class="text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto lg:mx-0 animate-fade-in-up animation-delay-200"
        >
          <span class="font-bold text-blue-900">Diagnóstico gratuito</span> de clima
          laboral, seguridad y bienestar para identificar riesgos y activar soluciones
        </p>

        <!-- CTA Buttons -->
        <div
          class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start animate-fade-in-up animation-delay-400"
        >
          <a
            href="/diagnostico"
            class="group relative px-8 py-4 bg-blue-900 hover:bg-blue-800 text-white font-semibold rounded-xl shadow-lg transition-all duration-300 transform hover:scale-105 hover:shadow-xl overflow-hidden"
          >
            <span class="relative z-10">Realizar Diagnóstico Gratuito</span>
            <div
              class="absolute inset-0 bg-gradient-to-r from-blue-600 to-blue-900 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
            >
            </div>
          </a>
          <button
            class="px-8 py-4 bg-white hover:bg-gray-50 text-gray-800 font-semibold rounded-xl shadow-md border-2 border-gray-200 hover:border-blue-900 transition-all duration-300 transform hover:scale-105"
          >
            Conocer los Workshops
          </button>
        </div>

        <!-- Experience Badge -->
        <div
          class="flex items-center justify-center lg:justify-start gap-3 animate-fade-in-up animation-delay-600"
        >
          <div class="flex -space-x-2">
            <div
              class="w-10 h-10 rounded-full bg-gradient-to-br from-blue-400 to-blue-600 border-2 border-white"
            >
            </div>
            <div
              class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-400 to-purple-600 border-2 border-white"
            >
            </div>
            <div
              class="w-10 h-10 rounded-full bg-gradient-to-br from-green-400 to-green-600 border-2 border-white"
            >
            </div>
          </div>
          <p class="text-sm sm:text-base text-gray-600 font-medium">
            Más de <span class="font-bold text-blue-900">25 años</span> transformando
            organizaciones en Latinoamérica
          </p>
        </div>
      </div>

      <!-- Right Content - Floating Cards with Connections -->
      <div class="relative h-[500px] lg:h-[600px] hidden lg:block">
        <!-- Center Hub -->
        <div
          class="absolute top-[58%] left-[58%] -translate-x-1/2 -translate-y-1/2 z-20"
        >
          <div
            class="floating-card-center w-24 h-24 bg-gradient-to-br from-blue-900 to-blue-700 rounded-2xl shadow-2xl flex items-center justify-center"
          >
            <svg
              class="w-16 h-16 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              ></path>
            </svg>
          </div>
        </div>

        <!-- Connecting Lines -->
        <svg class="absolute inset-0 w-full h-full z-10" viewBox="0 0 400 600">
          <!-- Top Left Line -->
          <path
            d="M 120 160 Q 160 200, 200 300"
            stroke="url(#gradient1)"
            stroke-width="2"
            fill="none"
            class="animated-line"
            stroke-dasharray="5,5"
          >
            <animate
              attributeName="stroke-dashoffset"
              from="0"
              to="10"
              dur="1s"
              repeatCount="indefinite"></animate>
          </path>

          <!-- Top Right Line -->
          <path
            d="M 280 160 Q 240 200, 200 300"
            stroke="url(#gradient1)"
            stroke-width="2"
            fill="none"
            class="animated-line"
            stroke-dasharray="5,5"
          >
            <animate
              attributeName="stroke-dashoffset"
              from="0"
              to="10"
              dur="1s"
              repeatCount="indefinite"></animate>
          </path>

          <!-- Bottom Left Line -->
          <path
            d="M 120 440 Q 160 380, 200 300"
            stroke="url(#gradient1)"
            stroke-width="2"
            fill="none"
            class="animated-line"
            stroke-dasharray="5,5"
          >
            <animate
              attributeName="stroke-dashoffset"
              from="0"
              to="10"
              dur="1s"
              repeatCount="indefinite"></animate>
          </path>

          <!-- Bottom Right Line -->
          <path
            d="M 280 440 Q 240 380, 200 300"
            stroke="url(#gradient1)"
            stroke-width="2"
            fill="none"
            class="animated-line"
            stroke-dasharray="5,5"
          >
            <animate
              attributeName="stroke-dashoffset"
              from="0"
              to="10"
              dur="1s"
              repeatCount="indefinite"></animate>
          </path>

          <defs>
            <linearGradient id="gradient1" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" style="stop-color:#3b82f6;stop-opacity:0.2"
              ></stop>
              <stop offset="50%" style="stop-color:#1e40af;stop-opacity:0.6"
              ></stop>
              <stop offset="100%" style="stop-color:#3b82f6;stop-opacity:0.2"
              ></stop>
            </linearGradient>
          </defs>
        </svg>

        <!-- Floating Cards -->

        <!-- Top Left Card -->
        <div class="absolute top-24 left-8 floating-card animation-delay-0">
          <div
            class="bg-white rounded-xl shadow-xl p-3 border border-gray-100 hover:shadow-2xl transition-shadow duration-300"
          >
            <div class="flex items-center gap-2 mb-1">
              <div
                class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center"
              >
                <svg
                  class="w-5 h-5 text-blue-600 transform -scale-x-100"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="3" y1="21" x2="21" y2="21"></line>
                  <rect x="4" y="10" width="4" height="11"></rect>
                  <rect x="10" y="6" width="4" height="15"></rect>
                  <rect x="16" y="3" width="4" height="18"></rect>
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500 font-medium">Reducción</p>
                <p class="text-base font-bold text-gray-900">8↓</p>
              </div>
            </div>
            <p class="text-xs text-gray-600">Accidentes</p>
          </div>
        </div>

        <!-- Top Right Card -->
        <div
          class="absolute top-24 right-8 floating-card animation-delay-1000 w-28"
        >
          <div
            class="bg-white rounded-xl shadow-xl p-3 border border-gray-100 hover:shadow-2xl transition-shadow duration-300"
          >
            <div class="flex items-center gap-2 mb-1">
              <div
                class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center"
              >
                <svg
                  class="w-5 h-5 text-blue-600 transform -scale-x-100"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500 font-medium">Mejora</p>
                <p class="text-base font-bold text-gray-900">75↑</p>
              </div>
            </div>
            <p class="text-xs text-gray-600">Satisfacción</p>
          </div>
        </div>

        <!-- Bottom Left Card -->
        <div
          class="absolute bottom-24 left-8 floating-card animation-delay-2000"
        >
          <div
            class="bg-white rounded-xl shadow-xl p-3 border border-gray-100 hover:shadow-2xl transition-shadow duration-300"
          >
            <div class="flex items-center gap-2 mb-1">
              <div
                class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center"
              >
                <svg
                  class="w-5 h-5 text-blue-600"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M17 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M7 21v-2a4 4 0 0 1 3-3.87"></path>
                  <circle cx="12" cy="7" r="4"></circle>
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500 font-medium">Retención</p>
                <p class="text-base font-bold text-gray-900">92%</p>
              </div>
            </div>
            <p class="text-xs text-gray-600">Talento</p>
          </div>
        </div>

        <!-- Bottom Right Card -->
        <div
          class="absolute bottom-24 right-8 floating-card animation-delay-3000 w-28"
        >
          <div
            class="bg-white rounded-xl shadow-xl p-3 border border-gray-100 hover:shadow-2xl transition-shadow duration-300"
          >
            <div class="flex items-center gap-2 mb-1">
              <div
                class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center"
              >
                <svg
                  class="w-5 h-5 text-blue-600"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M12 2L4 6V12C4 17 7 20 12 22C17 20 20 17 20 12V6L12 2Z"
                  ></path>
                  <path d="M9 12l2 2 4-4"></path>
                </svg>
              </div>
              <div>
                <p class="text-xs text-gray-500 font-medium">Seguridad</p>
                <p class="text-base font-bold text-gray-900">A+</p>
              </div>
            </div>
            <p class="text-xs text-gray-600">Certificación</p>
          </div>
        </div>
        <!--  End Cards -->
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg
      class="w-6 h-6 text-blue-600"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
    </svg>
  </div>
</section>

<style>
  /* Grid Pattern */
  .bg-grid-pattern {
    background-image:
      linear-gradient(to right, #e5e7eb 1px, transparent 1px),
      linear-gradient(to bottom, #e5e7eb 1px, transparent 1px);
    background-size: 40px 40px;
  }

  /* Blob Animation */
  @keyframes blob {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    25% {
      transform: translate(20px, -20px) scale(1.1);
    }
    50% {
      transform: translate(-20px, 20px) scale(0.9);
    }
    75% {
      transform: translate(20px, 20px) scale(1.05);
    }
  }

  .animate-blob {
    animation: blob 20s ease-in-out infinite;
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }

  .animation-delay-4000 {
    animation-delay: 4s;
  }

  /* Fade In Up Animation */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  .animation-delay-600 {
    animation-delay: 0.6s;
  }

  /* Floating Cards Animation */
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  @keyframes floatCenter {
    0%,
    100% {
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      transform: translate(-50%, -50%) scale(1.05);
    }
  }

  .floating-card {
    animation: float 6s ease-in-out infinite;
  }

  .floating-card-center {
    animation: floatCenter 4s ease-in-out infinite;
  }

  .animation-delay-1000 {
    animation-delay: 1s;
  }

  .animation-delay-3000 {
    animation-delay: 3s;
  }
</style>
