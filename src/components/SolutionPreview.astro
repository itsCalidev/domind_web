<style>
  /* Animaciones de entrada */
  @keyframes fadeInLeft {
    from {
      opacity: 0;
      transform: translateX(-50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes fadeInRight {
    from {
      opacity: 0;
      transform: translateX(50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-left {
    animation: fadeInLeft 0.8s ease-out;
  }

  .animate-fade-in-right {
    animation: fadeInRight 0.8s ease-out;
  }

  .metric-item,
  .benefit-item {
    animation: slideIn 0.6s ease-out forwards;
  }

  /* Animación del punto pulsante */
  @keyframes pulseDot {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.2);
    }
  }

  .animate-pulse-dot {
    animation: pulseDot 2s ease-in-out infinite;
  }

  /* Animación del arco del gauge - GIRO COMPLETO 360° */
  @keyframes drawArc {
    from {
      stroke-dasharray: 0 251;
    }
    to {
      stroke-dasharray: 125 251;
    }
  }

  @keyframes rotateArc {
    0% {
      transform: rotate(-90deg);
    }
    100% {
      transform: rotate(270deg);
    }
  }

  @keyframes pulseArc {
    0%,
    100% {
      stroke-width: 8;
      opacity: 1;
    }
    50% {
      stroke-width: 10;
      opacity: 0.9;
    }
  }

  .gauge-arc {
    animation:
      drawArc 2s ease-out forwards,
      pulseArc 3s ease-in-out 2s infinite;
  }

  /* Contenedor que gira el arco completo */
  .gauge-arc-container {
    animation: rotateArc 8s linear infinite;
    transform-origin: 50% 50%;
  }

  /* Animación del contador con pulso */
  @keyframes countUp {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes numberPulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.08);
    }
  }

  .counter {
    animation:
      countUp 0.5s ease-out,
      numberPulse 2s ease-in-out 2.5s infinite;
  }

  /* Gauge container sin rotación (solo el arco gira) */
  .gauge-container {
    position: relative;
  }

  /* Brillo pulsante en el fondo del gauge - MÁS INTENSO */
  @keyframes glowPulse {
    0%,
    100% {
      box-shadow:
        0 0 15px rgba(220, 38, 38, 0.2),
        0 0 30px rgba(220, 38, 38, 0.1);
    }
    50% {
      box-shadow:
        0 0 25px rgba(220, 38, 38, 0.4),
        0 0 50px rgba(220, 38, 38, 0.2);
    }
  }

  .gauge-glow {
    animation: glowPulse 3s ease-in-out infinite;
    border-radius: 50%;
  }

  /* Animación del indicador de la barra */
  @keyframes slideIndicator {
    from {
      left: 0%;
    }
    to {
      left: 28%;
    }
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateY(-50%) scale(1);
    }
    50% {
      transform: translateY(-50%) translateY(-3px) scale(1.1);
    }
  }

  .indicator-dot {
    animation:
      slideIndicator 1.5s ease-out 0.5s forwards,
      bounce 2s ease-in-out 2s infinite;
  }

  /* Animación de las barras de métricas con pulso */
  @keyframes fillBar {
    from {
      width: 0%;
    }
  }

  @keyframes barShimmer {
    0% {
      background-position: -200% center;
    }
    100% {
      background-position: 200% center;
    }
  }

  .metric-bar {
    animation: fillBar 1.5s ease-out forwards;
    background-size: 200% 100%;
    position: relative;
  }

  .metric-bar::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.4),
      transparent
    );
    animation: barShimmer 3s ease-in-out 2s infinite;
  }

  /* Pulso lento para el divisor */
  @keyframes pulseSlow {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }

  .animate-pulse-slow {
    animation: pulseSlow 3s ease-in-out infinite;
  }

  /* Animación sutil de respiración para la laptop */
  @keyframes breathe {
    0%,
    100% {
      transform: scale(1) translateY(0);
    }
    50% {
      transform: scale(1.01) translateY(-2px);
    }
  }

  .laptop-breathe {
    animation: breathe 4s ease-in-out infinite;
  }

  /* Shimmer effect en el texto "PELIGROSO" */
  @keyframes textGlow {
    0%,
    100% {
      text-shadow: 0 0 5px rgba(220, 38, 38, 0.3);
    }
    50% {
      text-shadow: 0 0 10px rgba(220, 38, 38, 0.6);
    }
  }

  .danger-text {
    animation: textGlow 2s ease-in-out infinite;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Animación del contador
    const counter = document.querySelector(".counter");
    if (counter) {
      const target = parseFloat(counter.getAttribute("data-target") || "2.8");
      let current = 0;
      const increment = target / 60;
      const timer = setInterval(() => {
        current += increment;
        if (current >= target) {
          current = target;
          clearInterval(timer);
        }
        counter.textContent = current.toFixed(1);
      }, 30);
    }

    // Animación de las barras de progreso
    const metricBars = document.querySelectorAll(".metric-bar");
    metricBars.forEach((bar) => {
      const width = bar.getAttribute("data-width");
      setTimeout(() => {
        (bar as HTMLElement).style.width = `${width}%`;
      }, 500);
    });

    // Animación continua de oscilación del contador después de cargar
    setTimeout(() => {
      if (counter) {
        setInterval(() => {
          const currentValue = parseFloat(counter.textContent || "2.8");
          const variation = (Math.random() - 0.5) * 0.1; // Variación de ±0.05
          const newValue = Math.max(
            2.7,
            Math.min(2.9, currentValue + variation),
          );
          counter.textContent = newValue.toFixed(1);
        }, 3000);
      }
    }, 3000);
  });
</script>
