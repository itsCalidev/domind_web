---

---

<section
  class="py-16 md:py-24 bg-gradient-to-b from-white to-gray-50 relative overflow-hidden"
>
  <!-- Decorative background elements -->
  <div
    class="absolute top-20 left-0 w-72 h-72 bg-blue-100 rounded-full filter blur-3xl opacity-20"
  >
  </div>
  <div
    class="absolute bottom-20 right-0 w-96 h-96 bg-blue-50 rounded-full filter blur-3xl opacity-30"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Title -->
    <h2
      class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 text-center mb-4"
    >
      <span class="text-blue-900">Diagnóstico</span> Estratégico Organizacional
    </h2>

    <!-- Divider with animation -->
    <div class="flex justify-center mb-6">
      <div
        class="w-24 h-1 bg-gradient-to-r from-transparent via-blue-900 to-transparent animate-pulse-slow"
      >
      </div>
    </div>

    <!-- Description -->
    <p
      class="text-base md:text-lg text-gray-600 text-center max-w-3xl mx-auto mb-12 leading-relaxed"
    >
      Descubra el estado actual de su organización con nuestro diagnóstico
      estratégico Identifique áreas de mejora y fortalezca su cultura
      organizacional para un futuro más seguro y productivo
    </p>

    <!-- Main Content Container with gray background -->
    <div
      class="bg-white rounded-3xl shadow-2xl p-6 md:p-10 lg:p-12 border border-gray-100"
    >
      <div class="grid md:grid-cols-2 gap-8 md:gap-12 lg:gap-16 items-center">
        <!-- Left Side: Dashboard Preview with animations -->
        <div class="flex justify-center animate-fade-in-left">
          <div class="relative w-full max-w-md group">
            <!-- Glow effect on hover -->
            <div
              class="absolute -inset-4 bg-gradient-to-r from-blue-600 to-blue-400 rounded-2xl opacity-0 group-hover:opacity-20 blur-xl transition-opacity duration-500"
            >
            </div>

            <!-- Laptop Frame -->
            <div
              class="relative bg-gray-800 rounded-t-xl p-2 shadow-2xl transform transition-transform duration-500 group-hover:scale-105 laptop-breathe"
            >
              <!-- Screen notch -->
              <div
                class="absolute top-0 left-1/2 -translate-x-1/2 w-20 h-1 bg-gray-700 rounded-b-lg"
              >
              </div>

              <div class="bg-white rounded-lg overflow-hidden">
                <!-- Dashboard Content -->
                <div class="p-6 md:p-8">
                  <!-- Header with pulse animation -->
                  <div class="text-xs text-gray-500 mb-4">
                    <div class="flex items-center gap-2 mb-2">
                      <div
                        class="w-2 h-2 bg-green-500 rounded-full animate-pulse-dot"
                      >
                      </div>
                      <span>Riesgo Organizacional: Alto</span>
                    </div>
                  </div>
                  <!-- Gauge Chart with animated arc -->
                  <div class="mb-6">
                    <div class="relative w-32 h-32 mx-auto gauge-container">
                      <!-- Fondo con glow pulsante -->
                      <div class="absolute inset-0 gauge-glow"></div>

                      <svg
                        class="w-full h-full relative z-10"
                        viewBox="0 0 100 100"
                      >
                        <!-- Background arc estático -->
                        <circle
                          cx="50"
                          cy="50"
                          r="40"
                          fill="none"
                          stroke="#e5e7eb"
                          stroke-width="8"
                          class="transition-all duration-300"></circle>

                        <!-- Grupo que gira con el arco rojo -->
                        <g class="gauge-arc-container" transform-origin="50 50">
                          <!-- Arco rojo que gira -->
                          <circle
                            cx="50"
                            cy="50"
                            r="40"
                            fill="none"
                            stroke="#dc2626"
                            stroke-width="8"
                            stroke-dasharray="125 251"
                            stroke-linecap="round"
                            class="gauge-arc"
                            transform="rotate(-90 50 50)"></circle>
                        </g>
                      </svg>

                      <div
                        class="absolute inset-0 flex flex-col items-center justify-center z-20"
                      >
                        <span
                          class="text-3xl font-bold text-gray-900 counter"
                          data-target="2.8">0</span
                        >
                        <span
                          class="text-xs text-gray-500 font-semibold danger-text"
                          >CRÍTICO</span
                        >
                      </div>
                    </div>
                  </div>

                  <!-- Color Scale with animated indicator -->
                  <div class="mb-6">
                    <div
                      class="h-2 rounded-full bg-gradient-to-r from-green-500 via-yellow-500 via-orange-500 to-red-500 relative"
                    >
                      <div
                        class="indicator-dot absolute w-3 h-3 bg-gray-900 rounded-full top-1/2 -translate-y-1/2 shadow-lg"
                        style="left: 28%;"
                      >
                      </div>
                    </div>
                  </div>

                  <!-- Metrics List with staggered animation -->
                  <div class="space-y-3">
                    <div
                      class="metric-item flex items-center justify-between text-sm opacity-0"
                      style="animation-delay: 0.1s;"
                    >
                      <div class="flex items-center gap-2">
                        <svg
                          class="w-4 h-4 text-green-600"
                          fill="currentColor"
                          viewBox="0 0 20 20"
