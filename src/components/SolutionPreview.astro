---

---

<section class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Title -->

    <h2
      class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 text-center mb-12 md:mb-16"
    >
      Diagnóstico Estratégico Organizacional
    </h2>
    <div class="border-t border-gray-100 mb-8"></div>
    <p class="text-lg text-gray-600 text-center max-w-3xl mx-auto">
      Descubra el estado actual de su organización con nuestro diagnóstico
      estratégico. Identifique áreas de mejora
    </p>
    <p class="text-lg text-gray-600 text-center max-w-3xl mx-auto mb-12">
      y fortalezca su cultura organizacional para un futuro más seguro y
      productivo.
    <div class="grid md:grid-cols-2 gap-8 md:gap-12 lg:gap-16 items-center">
      <!-- Left Side: Dashboard Preview -->
      <div class="flex justify-center">
        <div class="relative w-full max-w-md">
          <!-- Laptop Frame -->
          <div class="bg-gray-800 rounded-t-xl p-2 shadow-2xl">
            <div class="bg-white rounded-lg overflow-hidden">
              <!-- Dashboard Content -->
              <div class="p-6 md:p-8">
                <!-- Header -->
                <div class="text-xs text-gray-500 mb-4">
                  <div class="flex items-center gap-2 mb-2">
                    <div class="w-2 h-2 bg-green-500 rounded-full"></div>
                    <span>Riesgo Organizacional: Alto</span>
                  </div>
                </div>

                <!-- Gauge Chart -->
                <div class="mb-6">
                  <div class="relative w-32 h-32 mx-auto">
                    <svg
                      class="w-full h-full transform -rotate-90"
                      viewBox="0 0 100 100"
                    >
                      <circle
                        cx="50"
                        cy="50"
                        r="40"
                        fill="none"
                        stroke="#e5e7eb"
                        stroke-width="8"></circle>
                      <circle
                        cx="50"
                        cy="50"
                        r="40"
                        fill="none"
                        stroke="#dc2626"
                        stroke-width="8"
                        stroke-dasharray="125 251"
                        stroke-linecap="round"></circle>
                    </svg>
                    <div
                      class="absolute inset-0 flex flex-col items-center justify-center"
                    >
                      <span class="text-3xl font-bold text-gray-900">2.8</span>
                      <span class="text-xs text-gray-500">PELIGROSO</span>
                    </div>
                  </div>
                </div>

                <!-- Color Scale -->
                <div class="mb-6">
                  <div
                    class="h-2 rounded-full bg-gradient-to-r from-green-500 via-yellow-500 via-orange-500 to-red-500 relative"
                  >
                    <div
                      class="absolute w-3 h-3 bg-gray-900 rounded-full top-1/2 -translate-y-1/2 shadow-lg"
                      style="left: 28%;"
                    >
                    </div>
                  </div>
                </div>

                <!-- Metrics List -->
                <div class="space-y-3">
                  <div class="flex items-center justify-between text-sm">
                    <div class="flex items-center gap-2">
                      <svg
                        class="w-4 h-4 text-green-600"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                      </svg>
                      <span class="text-gray-700">Capacitación reciente</span>
                    </div>
                    <div class="flex items-center gap-2">
                      <div
                        class="w-24 h-2 bg-gray-200 rounded-full overflow-hidden"
                      >
                        <div
                          class="h-full bg-gradient-to-r from-green-500 to-red-500"
                          style="width: 65%;"
                        >
                        </div>
                      </div>
                      <span class="text-xs font-semibold text-gray-600">34</span
                      >
                    </div>
                  </div>

                  <div class="flex items-center justify-between text-sm">
                    <div class="flex items-center gap-2">
                      <svg
                        class="w-4 h-4 text-green-600"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                      </svg>
                      <span class="text-gray-700">Compartir expectativas</span>
                    </div>
                    <div class="flex items-center gap-2">
                      <div
                        class="w-24 h-2 bg-gray-200 rounded-full overflow-hidden"
                      >
                        <div
                          class="h-full bg-gradient-to-r from-green-500 via-orange-500 to-red-500"
                          style="width: 55%;"
                        >
                        </div>
                      </div>
                      <span class="text-xs font-semibold text-gray-600">28</span
                      >
                    </div>
                  </div>

                  <div class="flex items-center justify-between text-sm">
                    <div class="flex items-center gap-2">
                      <svg
                        class="w-4 h-4 text-green-600"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                      </svg>
                      <span class="text-gray-700">Tiempo Adecuado</span>
                    </div>
                    <div class="flex items-center gap-2">
                      <div
                        class="w-24 h-2 bg-gray-200 rounded-full overflow-hidden"
                      >
                        <div
                          class="h-full bg-gradient-to-r from-green-500 via-yellow-500 to-orange-500"
                          style="width: 45%;"
                        >
                        </div>
                      </div>
                      <span class="text-xs font-semibold text-gray-600">12</span
                      >
                    </div>
                  </div>

                  <div class="flex items-center justify-between text-sm">
                    <div class="flex items-center gap-2">
                      <svg
                        class="w-4 h-4 text-green-600"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path
                          fill-rule="evenodd"
                          d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                          clip-rule="evenodd"></path>
                      </svg>
                      <span class="text-gray-700">Carga no excesivas</span>
                    </div>
                    <div class="flex items-center gap-2">
                      <div
                        class="w-24 h-2 bg-gray-200 rounded-full overflow-hidden"
                      >
                        <div
                          class="h-full bg-gradient-to-r from-green-500 via-yellow-500 to-orange-500"
                          style="width: 40%;"
                        >
                        </div>
                      </div>
                      <span class="text-xs font-semibold text-gray-600">24</span
                      >
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!-- Laptop Bottom -->
          <div class="h-4 bg-gray-300 rounded-b-xl shadow-lg"></div>
          <div class="h-1 bg-gray-400 rounded-b-lg mx-auto w-3/4"></div>
        </div>
      </div>

      <!-- Right Side: Benefits List -->
      <div class="space-y-6">
        <div class="flex items-start gap-4 group">
          <div class="flex-shrink-0 mt-1">
            <svg
              class="w-6 h-6 text-green-600"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
          <div>
            <h3
              class="text-lg md:text-xl font-semibold text-gray-900 group-hover:text-blue-900 transition-colors"
            >
              Condiciones laborales
            </h3>
          </div>
        </div>

        <div class="flex items-start gap-4 group">
          <div class="flex-shrink-0 mt-1">
            <svg
              class="w-6 h-6 text-green-600"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
          <div>
            <h3
              class="text-lg md:text-xl font-semibold text-gray-900 group-hover:text-blue-900 transition-colors"
            >
              Oportunidades de crecimiento
            </h3>
          </div>
        </div>

        <div class="flex items-start gap-4 group">
          <div class="flex-shrink-0 mt-1">
            <svg
              class="w-6 h-6 text-green-600"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
          <div>
            <h3
              class="text-lg md:text-xl font-semibold text-gray-900 group-hover:text-blue-900 transition-colors"
            >
              Relaciones y liderazgo
            </h3>
          </div>
        </div>

        <div class="flex items-start gap-4 group">
          <div class="flex-shrink-0 mt-1">
            <svg
              class="w-6 h-6 text-green-600"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
          <div>
            <h3
              class="text-lg md:text-xl font-semibold text-gray-900 group-hover:text-blue-900 transition-colors"
            >
              Cultura de seguridad
            </h3>
          </div>
        </div>

        <div class="flex items-start gap-4 group">
          <div class="flex-shrink-0 mt-1">
            <svg
              class="w-6 h-6 text-green-600"
              fill="currentColor"
              viewBox="0 0 20 20"
            >
              <path
                fill-rule="evenodd"
                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                clip-rule="evenodd"></path>
            </svg>
          </div>
          <div>
            <h3
              class="text-lg md:text-xl font-semibold text-gray-900 group-hover:text-blue-900 transition-colors"
            >
              Riesgos psicosociales
            </h3>
          </div>
        </div>

        <!-- CTA Button -->
        <div class="pt-4">
          <button
            class="px-8 py-3.5 bg-blue-900 hover:bg-blue-800 text-white font-semibold rounded-lg shadow-lg transition-all duration-200 transform hover:scale-105"
          >
            Iniciar Diagnóstico
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
