---
const workshops = [
  {
    id: 1,
    title: "Clima Laboral y Seguridad",
    description: "Transformación integral del ambiente de trabajo",
    image:
      "https://images.unsplash.com/photo-1552664730-d307ca884978?w=800&q=80",
    category: "Taller Presencial",
    duration: "2 días",
    participants: "15-25 personas",
  },
  {
    id: 2,
    title: "Liderazgo Organizacional",
    description: "Desarrollo de habilidades directivas efectivas",
    image:
      "https://images.unsplash.com/photo-1556761175-b413da4baf72?w=800&q=80",
    category: "Workshop Intensivo",
    duration: "1 día",
    participants: "10-20 personas",
  },
  {
    id: 3,
    title: "Prevención de Riesgos Psicosociales",
    description: "Identificación y manejo de factores de riesgo",
    image:
      "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=800&q=80",
    category: "Certificación",
    duration: "3 días",
    participants: "20-30 personas",
  },
  {
    id: 4,
    title: "Cultura de Seguridad",
    description: "Implementación de protocolos y mejores prácticas",
    image:
      "https://images.unsplash.com/photo-1521737711867-e3b97375f902?w=800&q=80",
    category: "Taller Práctico",
    duration: "2 días",
    participants: "15-25 personas",
  },
  {
    id: 5,
    title: "Gestión del Cambio Organizacional",
    description: "Estrategias para transformación efectiva",
    image:
      "https://images.unsplash.com/photo-1542744173-8e7e53415bb0?w=800&q=80",
    category: "Consultoría",
    duration: "4 sesiones",
    participants: "Equipos directivos",
  },
];
---

<section
  id="workshops"
  class="py-16 md:py-24 bg-gradient-to-b from-gray-50 to-white relative overflow-hidden"
>
  <!-- Decorative elements -->
  <div
    class="absolute top-0 right-0 w-96 h-96 bg-blue-100 rounded-full filter blur-3xl opacity-20 translate-x-1/2 -translate-y-1/2"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 w-96 h-96 bg-purple-100 rounded-full filter blur-3xl opacity-20 -translate-x-1/2 translate-y-1/2"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Header Section -->
    <div class="text-center mb-12 md:mb-16 animate-fade-in-up">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        Nuestros <span class="text-blue-900">Workshops</span>
      </h2>

      <div class="flex justify-center mb-6">
        <div
          class="w-24 h-1 bg-gradient-to-r from-transparent via-blue-900 to-transparent"
        >
        </div>
      </div>
      <p class="text-base md:text-lg text-gray-600 max-w-3xl mx-auto mb-8">
        Programas especializados diseñados para transformar tu organización con
        metodologías probadas y <span
          class="font-semibold text-blue-900 relative inline-block"
        >
          resultados medibles
          <span class="absolute bottom-0 left-0 w-full h-1 bg-blue-900/20"
          ></span>
        </span>
      </p>
    </div>

    <!-- Workshop Carousel -->
    <div class="relative mb-16">
      <!-- Desktop View -->
      <div class="hidden lg:block">
        <div class="relative h-[500px]">
          <div id="workshop-container" class="relative w-full h-full">
            {
              workshops.map((workshop, index) => (
                <div
                  data-workshop-index={index}
                  class="workshop-card absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 transition-all duration-700 ease-out"
                  style="opacity: 0; transform: translate(-50%, -50%) scale(0.8);"
                >
                  <div class="relative group">
                    {/* Workshop Image Card */}
                    <div class="relative overflow-hidden rounded-2xl shadow-2xl">
                      <img
                        src={workshop.image}
                        alt={workshop.title}
                        class="w-[500px] h-[450px] object-cover transition-transform duration-500 group-hover:scale-110"
                      />

                      {/* Gradient Overlay */}
                      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent" />

                      {/* Category Badge */}
                      <div class="absolute top-4 left-4">
                        <span class="px-4 py-2 bg-blue-900/90 backdrop-blur-sm text-white text-sm font-semibold rounded-full shadow-lg">
                          {workshop.category}
                        </span>
                      </div>

                      {/* Content */}
                      <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
                        <h3 class="text-2xl font-bold mb-2 transform transition-transform duration-300 group-hover:translate-y-[-4px]">
                          {workshop.title}
                        </h3>
                        <p class="text-gray-200 text-base mb-4 line-clamp-2">
                          {workshop.description}
                        </p>

                        {/* Workshop Details */}
                        <div class="flex flex-wrap gap-4 text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                          <div class="flex items-center gap-2">
                            <svg
                              class="w-4 h-4"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                              />
                            </svg>
                            <span>{workshop.duration}</span>
                          </div>
                          <div class="flex items-center gap-2">
                            <svg
                              class="w-4 h-4"
                              fill="none"
                              stroke="currentColor"
                              viewBox="0 0 24 24"
                            >
                              <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                              />
                            </svg>
                            <span>{workshop.participants}</span>
                          </div>
                        </div>

                        {/* CTA Button */}
                        <button class="mt-4 px-6 py-2.5 bg-white text-blue-900 font-semibold rounded-lg opacity-0 group-hover:opacity-100 transition-all duration-300 transform group-hover:translate-y-0 translate-y-2 hover:bg-blue-50">
                          Más información
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        {/* Navigation Arrows */}
        <button
          id="workshop-prev"
          class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 w-14 h-14 bg-white hover:bg-blue-900 rounded-full shadow-xl flex items-center justify-center transition-all duration-300 hover:scale-110 group z-20"
        >
          <svg
            class="w-6 h-6 text-gray-700 group-hover:text-white transition-colors"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"></path>
          </svg>
        </button>

        <button
          id="workshop-next"
          class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 w-14 h-14 bg-white hover:bg-blue-900 rounded-full shadow-xl flex items-center justify-center transition-all duration-300 hover:scale-110 group z-20"
        >
          <svg
            class="w-6 h-6 text-gray-700 group-hover:text-white transition-colors"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile View -->
      <div class="lg:hidden">
        <div id="mobile-workshop-carousel" class="overflow-hidden rounded-2xl">
          <div
            id="mobile-workshop-track"
            class="flex transition-transform duration-500 ease-out"
          >
            {
              workshops.map((workshop) => (
                <div class="flex-shrink-0 w-full px-4">
                  <div class="relative overflow-hidden rounded-2xl shadow-xl">
                    <img
                      src={workshop.image}
                      alt={workshop.title}
                      class="w-full h-[400px] object-cover"
                    />

                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent" />

                    <div class="absolute top-4 left-4">
                      <span class="px-4 py-2 bg-blue-900/90 backdrop-blur-sm text-white text-sm font-semibold rounded-full">
                        {workshop.category}
                      </span>
                    </div>

                    <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
                      <h3 class="text-xl font-bold mb-2">{workshop.title}</h3>
                      <p class="text-gray-200 text-sm mb-4">
                        {workshop.description}
                      </p>

                      <div class="flex flex-wrap gap-3 text-xs mb-4">
                        <div class="flex items-center gap-2">
                          <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                            />
                          </svg>
                          <span>{workshop.duration}</span>
                        </div>
                        <div class="flex items-center gap-2">
                          <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                            />
                          </svg>
                          <span>{workshop.participants}</span>
                        </div>
                      </div>

                      <button class="w-full py-2.5 bg-white text-blue-900 font-semibold rounded-lg hover:bg-blue-50 transition-colors">
                        Más información
                      </button>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      {/* Dots Indicators */}
      <div class="flex justify-center gap-2 mt-8">
        {
          workshops.map((_, index) => (
            <button
              data-workshop-dot={index}
              class="workshop-dot w-2.5 h-2.5 rounded-full bg-gray-300 transition-all duration-300 hover:bg-blue-900"
            />
          ))
        }
      </div>
    </div>

    {/* Author Info Section */}
    <div
      class="bg-white rounded-2xl shadow-xl p-8 md:p-12 border border-gray-100"
    >
      <div class="max-w-4xl mx-auto text-center">
        <h3 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4">
          Dr. José Luis Calderón Mafud
        </h3>

        <p class="text-base md:text-lg text-gray-600 mb-6">
          Psicólogo Organizacional & Consultor ICOH - OMS
        </p>

        <!-- Social Links — sweep fill buttons -->
        <div class="flex items-center justify-center gap-3 mb-4 flex-wrap">
          <!-- LinkedIn -->
          <a
            href="https://www.linkedin.com/in/domind/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-sweep btn-sweep-linkedin inline-flex items-center gap-2 px-4 py-2 bg-white text-blue-600 font-medium rounded-lg shadow-sm border border-blue-200"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
              ></path>
            </svg>
            <span class="text-sm">Linkedin</span>
          </a>

          <!-- Podcast -->
          <a
            href="#podcast"
            class="btn-sweep btn-sweep-podcast inline-flex items-center gap-2 px-4 py-2 bg-white text-gray-700 font-medium rounded-lg shadow-sm border border-gray-200"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 2c5.514 0 10 4.486 10 10s-4.486 10-10 10S2 17.514 2 12 6.486 2 12 2zm0 3c-3.866 0-7 3.134-7 7 0 2.496 1.335 4.686 3.324 5.907l.676-1.737C7.47 15.355 6.5 13.797 6.5 12c0-3.033 2.467-5.5 5.5-5.5s5.5 2.467 5.5 5.5c0 1.797-.97 3.355-2.5 4.17l.676 1.737C17.665 16.686 19 14.496 19 12c0-3.866-3.134-7-7-7zm0 3c-2.209 0-4 1.791-4 4 0 1.48.81 2.773 2.012 3.465l.676-1.738C9.67 13.273 9 12.698 9 12c0-1.657 1.343-3 3-3s3 1.343 3 3c0 .698-.67 1.273-1.688 1.727l.676 1.738C15.19 14.773 16 13.48 16 12c0-2.209-1.791-4-4-4zm0 2.5c-.828 0-1.5.672-1.5 1.5s.672 1.5 1.5 1.5 1.5-.672 1.5-1.5-.672-1.5-1.5-1.5zm0 4.5c-.552 0-1 .448-1 1v3c0 .552.448 1 1 1s1-.448 1-1v-3c0-.552-.448-1-1-1z"
              ></path>
            </svg>
            <span class="text-sm">Podcast</span>
          </a>

          <!-- Email -->
          <a
            href="mailto:contacto@domind.com"
            class="btn-sweep btn-sweep-email inline-flex items-center gap-2 px-4 py-2 bg-white text-gray-700 font-medium rounded-lg shadow-sm border border-gray-200"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path
                d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
              ></path>
            </svg>
            <span class="text-sm">Email</span>
          </a>
        </div>

        {/* CTA */}
        <div class="space-y-4">
          <h4 class="text-xl md:text-2xl font-bold text-gray-900">
            Transforme su organización hoy
          </h4>

          <!-- CTA Buttons -->
          <div
            class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in-up animation-delay-400"
          >
            <a
              href="/workshops"
              class="group relative px-8 py-4 bg-blue-900 hover:bg-blue-800 text-white font-semibold rounded-xl shadow-lg transition-all duration-300 transform hover:scale-105 hover:shadow-xl overflow-hidden"
            >
              <span class="relative z-10">Conozca nuestros Workshops</span>
              <div
                class="absolute inset-0 bg-gradient-to-r from-blue-600 to-blue-900 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
              >
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .workshop-dot.active {
    background-color: #1e3a8a;
    width: 2rem;
  }

  .workshop-card {
    pointer-events: none;
  }

  .workshop-card.active {
    pointer-events: auto;
  }
</style>
<style>
  /* ── Fill / Sweep buttons ── */
  .btn-sweep {
    position: relative;
    overflow: hidden;
    z-index: 0;
    transition:
      color 0.35s ease,
      box-shadow 0.35s ease;
  }
  .btn-sweep::before {
    content: "";
    position: absolute;
    inset: 0;
    transform: translateX(-101%);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: -1;
    border-radius: inherit;
  }
  .btn-sweep:hover::before {
    transform: translateX(0);
  }

  /* LinkedIn — fills with LinkedIn blue */
  .btn-sweep-linkedin::before {
    background-color: #0077b5;
  }
  .btn-sweep-linkedin:hover {
    color: #ffffff;
    border-color: #0077b5 !important;
    box-shadow: 0 4px 18px rgba(0, 119, 181, 0.35);
  }
  .btn-sweep-linkedin:hover svg {
    color: #ffffff;
  }

  /* Podcast — fills with warm slate */
  .btn-sweep-podcast::before {
    background-color: #374151;
  }
  .btn-sweep-podcast:hover {
    color: #ffffff;
    border-color: #374151 !important;
    box-shadow: 0 4px 18px rgba(55, 65, 81, 0.25);
  }
  .btn-sweep-podcast:hover svg {
    color: #ffffff;
  }

  /* Email — fills with indigo */
  .btn-sweep-email::before {
    background-color: #004a98;
  }
  .btn-sweep-email:hover {
    color: #ffffff;
    border-color: #004a98 !important;
    box-shadow: 0 4px 18px rgba(0, 74, 152, 0.3);
  }
  .btn-sweep-email:hover svg {
    color: #ffffff;
  }

  /* CTA — fills from right to left with a lighter shade */
  .btn-sweep-cta::before {
    transform: translateX(101%); /* enters from right */
    background-color: #1e3a8a; /* blue-900 darker shade */
  }
  .btn-sweep-cta:hover::before {
    transform: translateX(0);
  }
  .btn-sweep-cta:hover {
    box-shadow: 0 8px 30px rgba(30, 58, 138, 0.45);
    transform: scale(1.03);
  }

  /* Keep SVG color transition smooth */
  .btn-sweep svg {
    transition: color 0.35s ease;
  }
</style>
<script>
  let workshopIndex = 0;
  let mobileWorkshopIndex = 0;
  const totalWorkshops = 5;
  const isDesktop = window.innerWidth >= 1024;

  const workshopCards = document.querySelectorAll(
    ".workshop-card",
  ) as NodeListOf<HTMLElement>;
  const workshopDots = document.querySelectorAll(".workshop-dot");
  const prevBtn = document.getElementById("workshop-prev");
  const nextBtn = document.getElementById("workshop-next");
  const mobileTrack = document.getElementById("mobile-workshop-track");
  const mobileCarousel = document.getElementById("mobile-workshop-carousel");

  function updateWorkshopCarousel() {
    workshopCards.forEach((card, index) => {
      const diff = index - workshopIndex;

      card.classList.remove("active");

      if (diff === 0) {
        // Center card
        card.style.transform = "translate(-50%, -50%) scale(1)";
        card.style.opacity = "1";
        card.style.zIndex = "30";
        card.style.filter = "blur(0px)";
        card.classList.add("active");
      } else if (
        diff === -1 ||
        (workshopIndex === 0 && index === totalWorkshops - 1)
      ) {
        // Left card
        card.style.transform =
          "translate(-50%, -50%) translateX(-550px) scale(0.75)";
        card.style.opacity = "0.3";
        card.style.zIndex = "10";
        card.style.filter = "blur(2px)";
      } else if (
        diff === 1 ||
        (workshopIndex === totalWorkshops - 1 && index === 0)
      ) {
        // Right card
        card.style.transform =
          "translate(-50%, -50%) translateX(550px) scale(0.75)";
        card.style.opacity = "0.3";
        card.style.zIndex = "10";
        card.style.filter = "blur(2px)";
      } else {
        // Hidden
        card.style.transform = "translate(-50%, -50%) scale(0.6)";
        card.style.opacity = "0";
        card.style.zIndex = "0";
        card.style.filter = "blur(3px)";
      }
    });

    updateWorkshopDots(workshopIndex);
  }

  function updateMobileWorkshop() {
    if (mobileTrack) {
      (mobileTrack as HTMLElement).style.transform =
        `translateX(-${mobileWorkshopIndex * 100}%)`;
    }
    updateWorkshopDots(mobileWorkshopIndex);
  }

  function updateWorkshopDots(activeIndex: number) {
    workshopDots.forEach((dot, index) => {
      if (index === activeIndex) {
        dot.classList.add("active");
      } else {
        dot.classList.remove("active");
      }
    });
  }

  function nextWorkshop() {
    if (isDesktop) {
      workshopIndex = (workshopIndex + 1) % totalWorkshops;
      updateWorkshopCarousel();
    } else {
      mobileWorkshopIndex = (mobileWorkshopIndex + 1) % totalWorkshops;
      updateMobileWorkshop();
    }
  }

  function prevWorkshop() {
    if (isDesktop) {
      workshopIndex = (workshopIndex - 1 + totalWorkshops) % totalWorkshops;
      updateWorkshopCarousel();
    } else {
      mobileWorkshopIndex =
        (mobileWorkshopIndex - 1 + totalWorkshops) % totalWorkshops;
      updateMobileWorkshop();
    }
  }

  prevBtn?.addEventListener("click", prevWorkshop);
  nextBtn?.addEventListener("click", nextWorkshop);

  workshopDots.forEach((dot, index) => {
    dot.addEventListener("click", () => {
      if (isDesktop) {
        workshopIndex = index;
        updateWorkshopCarousel();
      } else {
        mobileWorkshopIndex = index;
        updateMobileWorkshop();
      }
    });
  });

  // Touch swipe for mobile
  let touchStartX = 0;
  mobileCarousel?.addEventListener("touchstart", (e) => {
    touchStartX = e.changedTouches[0].screenX;
  });

  mobileCarousel?.addEventListener("touchend", (e) => {
    const touchEndX = e.changedTouches[0].screenX;
    const diff = touchStartX - touchEndX;

    if (Math.abs(diff) > 50) {
      if (diff > 0) {
        mobileWorkshopIndex = (mobileWorkshopIndex + 1) % totalWorkshops;
      } else {
        mobileWorkshopIndex =
          (mobileWorkshopIndex - 1 + totalWorkshops) % totalWorkshops;
      }
      updateMobileWorkshop();
    }
  });

  // Auto-play
  setInterval(nextWorkshop, 5000);

  // Initialize
  if (isDesktop) {
    updateWorkshopCarousel();
  } else {
    updateMobileWorkshop();
  }
</script>
