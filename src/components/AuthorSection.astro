---
---

<section class="py-16 md:py-24 bg-gradient-to-br from-gray-50 to-gray-100 relative overflow-hidden">
  <!-- Decorative background elements -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-blue-100 rounded-full filter blur-3xl opacity-20 -translate-y-1/2 translate-x-1/2"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-blue-50 rounded-full filter blur-3xl opacity-30 translate-y-1/2 -translate-x-1/2"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid md:grid-cols-2 gap-8 md:gap-16 items-center">
      <!-- Left Side: Author Photo with transparent background -->
      <div class="flex justify-center md:justify-end order-2 md:order-1">
        <div class="relative">
          <!-- La imagen debe tener fondo transparente (PNG sin fondo) -->
          <img
            src="src/assets/pic.png"
            alt="Dr. José Luis Calderón Mafud"
            class="w-80 h-80 md:w-96 md:h-96 lg:w-[450px] lg:h-[450px] object-contain drop-shadow-2xl"
          />
        </div>
      </div>

      <!-- Right Side: Author Info & CTA -->
      <div class="order-1 md:order-2 text-center md:text-left">
        <!-- Name & Title -->
        <div class="mb-8">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">
            Dr. José Luis Calderón Mafud
          </h2>

          <!-- Social Links - Styled as badges -->
          <div class="flex items-center justify-center md:justify-start gap-3 mb-4 flex-wrap">
            
              <a href="https://www.linkedin.com/in/domind/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-white hover:bg-blue-50 text-blue-600 font-medium rounded-lg shadow-sm border border-blue-200 transition-all duration-200 hover:shadow-md"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
              </svg>
              <span class="text-sm">Linkedin</span>
            </a>

            
              <a href="#podcast"
              class="inline-flex items-center gap-2 px-4 py-2 bg-white hover:bg-gray-50 text-gray-700 font-medium rounded-lg shadow-sm border border-gray-200 transition-all duration-200 hover:shadow-md"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm0 2c5.514 0 10 4.486 10 10s-4.486 10-10 10S2 17.514 2 12 6.486 2 12 2zm0 3c-3.866 0-7 3.134-7 7 0 2.496 1.335 4.686 3.324 5.907l.676-1.737C7.47 15.355 6.5 13.797 6.5 12c0-3.033 2.467-5.5 5.5-5.5s5.5 2.467 5.5 5.5c0 1.797-.97 3.355-2.5 4.17l.676 1.737C17.665 16.686 19 14.496 19 12c0-3.866-3.134-7-7-7zm0 3c-2.209 0-4 1.791-4 4 0 1.48.81 2.773 2.012 3.465l.676-1.738C9.67 13.273 9 12.698 9 12c0-1.657 1.343-3 3-3s3 1.343 3 3c0 .698-.67 1.273-1.688 1.727l.676 1.738C15.19 14.773 16 13.48 16 12c0-2.209-1.791-4-4-4zm0 2.5c-.828 0-1.5.672-1.5 1.5s.672 1.5 1.5 1.5 1.5-.672 1.5-1.5-.672-1.5-1.5-1.5zm0 4.5c-.552 0-1 .448-1 1v3c0 .552.448 1 1 1s1-.448 1-1v-3c0-.552-.448-1-1-1z"></path>
              </svg>
              <span class="text-sm">Podcast</span>
            </a>

            
             <a href="mailto:contacto@domind.com"
              class="inline-flex items-center gap-2 px-4 py-2 bg-white hover:bg-gray-50 text-gray-700 font-medium rounded-lg shadow-sm border border-gray-200 transition-all duration-200 hover:shadow-md"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"></path>
              </svg>
              <span class="text-sm">Email</span>
            </a>
          </div>

          <p class="text-base md:text-lg text-gray-600 font-medium">
            Psicólogo Organizacional & Consultor ICOH - OMS
          </p>
        </div>

        <!-- CTA Section -->
        <div class="space-y-6 text-start" >
          <h3 class="text-start text-2xl md:text-3xl lg:text-4xl font-bold text-gray-900 leading-tight">
            Transforme su organización hoy
          </h3>

          
            <a href="/diagnostico"
            class="inline-block w-full md:w-auto px-10 py-4 bg-blue-900 hover:bg-blue-800 text-white text-lg font-semibold rounded-xl shadow-xl transition-all duration-200 transform hover:scale-105"
          >
            Realizar Diagnóstico Gratuito
          </a>
        </div>
      </div>
    </div>
  </div>
</section>