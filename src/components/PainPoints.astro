---
import { UserX, Users, UserCircle, ClipboardCheck, CheckSquare } from 'lucide-react';
---

<section class="py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Title -->
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 text-center mb-12 md:mb-16">
      ¿Está ocurriendo esto en su organización?
    </h2>

    <!-- Pain Points Grid -->
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-6 md:gap-8 lg:gap-10 mb-12">
      <!-- Accidentes Frecuentes -->
      <div class="flex flex-col items-center text-center group">
        <div class="w-20 h-20 md:w-24 md:h-24 bg-blue-50 rounded-full flex items-center justify-center mb-4 group-hover:bg-blue-100 transition-colors">
          <svg class="w-10 h-10 md:w-12 md:h-12 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <h3 class="text-sm md:text-base font-semibold text-gray-900 mb-1">Accidentes Frecuentes</h3>
      </div>

      <!-- Alta Rotación -->
      <div class="flex flex-col items-center text-center group">
        <div class="w-20 h-20 md:w-24 md:h-24 bg-blue-50 rounded-full flex items-center justify-center mb-4 group-hover:bg-blue-100 transition-colors">
          <svg class="w-10 h-10 md:w-12 md:h-12 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
        </div>
        <h3 class="text-sm md:text-base font-semibold text-gray-900 mb-1">Alta Rotación</h3>
      </div>

      <!-- Conflictos de Area -->
      <div class="flex flex-col items-center text-center group">
        <div class="w-20 h-20 md:w-24 md:h-24 bg-blue-50 rounded-full flex items-center justify-center mb-4 group-hover:bg-blue-100 transition-colors">
          <svg class="w-10 h-10 md:w-12 md:h-12 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
          </svg>
        </div>
        <h3 class="text-sm md:text-base font-semibold text-gray-900 mb-1">Conflictos de Área</h3>
      </div>

      <!-- Condicionss Laborales Deficientes -->
      <div class="flex flex-col items-center text-center group">
        <div class="w-20 h-20 md:w-24 md:h-24 bg-blue-50 rounded-full flex items-center justify-center mb-4 group-hover:bg-blue-100 transition-colors">
          <svg class="w-10 h-10 md:w-12 md:h-12 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <h3 class="text-sm md:text-base font-semibold text-gray-900 mb-1">Condicionss Laborales Deficientes</h3>
      </div>

      <!-- Desmotivación -->
      <div class="flex flex-col items-center text-center group">
        <div class="w-20 h-20 md:w-24 md:h-24 bg-blue-50 rounded-full flex items-center justify-center mb-4 group-hover:bg-blue-100 transition-colors">
          <svg class="w-10 h-10 md:w-12 md:h-12 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
          </svg>
        </div>
        <h3 class="text-sm md:text-base font-semibold text-gray-900 mb-1">Desmotivación</h3>
      </div>
    </div>

    <!-- Bottom Text -->
    <p class="text-center text-base md:text-lg text-gray-700 font-medium">
      <span class="font-bold">El clima laboral</span> es el indicador temprano de todos estos problemas.
    </p>
  </div>
</section>