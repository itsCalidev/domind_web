---

---

<section class="py-16 md:py-24 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Title -->
    <h2
      class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 text-center mb-4"
    >
      ¿En su <span class="text-blue-900">organización</span> está ocurriendo esto?
    </h2>

    <!-- Pain Points Grid -->
    <div
      class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6 md:gap-8 lg:gap-6 mb-12 mt-16"
    >
      <!-- Accidentes Frecuentes -->
      <div
        class="flex flex-col items-center text-center group animate-fade-in-up"
        style="animation-delay: 0.1s;"
      >
        <div class="relative mb-4">
          <!-- Círculo de fondo con animación -->
          <div
            class="w-24 h-24 md:w-28 md:h-28 bg-gradient-to-br from-blue-50 to-blue-100 rounded-full flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-hover:shadow-xl group-hover:from-blue-100 group-hover:to-blue-200 relative"
          >
            <!-- Anillo pulsante -->
            <div
              class="absolute inset-0 rounded-full bg-blue-200 opacity-0 group-hover:opacity-100 animate-ping-slow"
            >
            </div>

            <svg
              class="w-12 h-12 md:w-14 md:h-14 text-blue-900 relative z-10 transition-transform duration-300 group-hover:rotate-12 group-hover:scale-110"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
              ></path>
            </svg>
          </div>
        </div>
        <h3
          class="text-sm md:text-base font-bold text-gray-900 mb-1 transition-colors group-hover:text-blue-900"
        >
          Accidentes Frecuentes
        </h3>
      </div>

      <!-- Alta Rotación -->
      <div
        class="flex flex-col items-center text-center group animate-fade-in-up"
        style="animation-delay: 0.2s;"
      >
        <div class="relative mb-4">
          <div
            class="w-24 h-24 md:w-28 md:h-28 bg-gradient-to-br from-blue-50 to-blue-100 rounded-full flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-hover:shadow-xl group-hover:from-blue-100 group-hover:to-blue-200 relative"
          >
            <div
              class="absolute inset-0 rounded-full bg-blue-200 opacity-0 group-hover:opacity-100 animate-ping-slow"
            >
            </div>

            <svg
              class="w-12 h-12 md:w-14 md:h-14 text-blue-900 relative z-10 transition-transform duration-300 group-hover:rotate-180"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
              ></path>
            </svg>
          </div>
        </div>
        <h3
          class="text-sm md:text-base font-bold text-gray-900 mb-1 transition-colors group-hover:text-blue-900"
        >
          Alta Rotación
        </h3>
      </div>

      <!-- Conflictos de Área -->
      <div
        class="flex flex-col items-center text-center group animate-fade-in-up"
        style="animation-delay: 0.3s;"
      >
        <div class="relative mb-4">
          <div
            class="w-24 h-24 md:w-28 md:h-28 bg-gradient-to-br from-blue-50 to-blue-100 rounded-full flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-hover:shadow-xl group-hover:from-blue-100 group-hover:to-blue-200 relative"
          >
            <div
              class="absolute inset-0 rounded-full bg-blue-200 opacity-0 group-hover:opacity-100 animate-ping-slow"
            >
            </div>

            <svg
              class="w-12 h-12 md:w-14 md:h-14 text-blue-900 relative z-10 transition-all duration-300 group-hover:scale-110"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
              ></path>
            </svg>
          </div>
        </div>
        <h3
          class="text-sm md:text-base font-bold text-gray-900 mb-1 transition-colors group-hover:text-blue-900"
        >
          Conflictos de Área
        </h3>
      </div>

      <!-- Condiciones Laborales Deficientes -->
      <div
        class="flex flex-col items-center text-center group animate-fade-in-up"
        style="animation-delay: 0.4s;"
      >
        <div class="relative mb-4">
          <div
            class="w-24 h-24 md:w-28 md:h-28 bg-gradient-to-br from-blue-50 to-blue-100 rounded-full flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-hover:shadow-xl group-hover:from-blue-100 group-hover:to-blue-200 relative"
          >
            <div
              class="absolute inset-0 rounded-full bg-blue-200 opacity-0 group-hover:opacity-100 animate-ping-slow"
            >
            </div>

            <svg
              class="w-12 h-12 md:w-14 md:h-14 text-blue-900 relative z-10 transition-transform duration-300 group-hover:-translate-y-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              ></path>
            </svg>
          </div>
        </div>
        <h3
          class="text-sm md:text-base font-bold text-gray-900 mb-1 transition-colors group-hover:text-blue-900"
        >
          Condiciones Laborales Deficientes
        </h3>
      </div>

      <!-- Desmotivación -->
      <div
        class="flex flex-col items-center text-center group animate-fade-in-up"
        style="animation-delay: 0.5s;"
      >
        <div class="relative mb-4">
          <div
            class="w-24 h-24 md:w-28 md:h-28 bg-gradient-to-br from-blue-50 to-blue-100 rounded-full flex items-center justify-center transition-all duration-300 group-hover:scale-110 group-hover:shadow-xl group-hover:from-blue-100 group-hover:to-blue-200 relative"
          >
            <div
              class="absolute inset-0 rounded-full bg-blue-200 opacity-0 group-hover:opacity-100 animate-ping-slow"
            >
            </div>

            <svg
              class="w-12 h-12 md:w-14 md:h-14 text-blue-900 relative z-10 transition-all duration-300 group-hover:scale-110"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"
              ></path>
            </svg>
          </div>
        </div>
        <h3
          class="text-sm md:text-base font-bold text-gray-900 mb-1 transition-colors group-hover:text-blue-900"
        >
          Desmotivación
        </h3>
      </div>
    </div>

    <!-- Bottom Text with highlight -->
    <div class="text-center max-w-3xl mx-auto">
      <p class="text-base md:text-xl text-gray-700 leading-relaxed">
        <span
          class="font-bold text-blue-900 relative inline-block text-2xl md:text-2xl"
        >
          El clima laboral
          <span class="absolute bottom-0 left-0 w-full h-1 bg-blue-900/20"
          ></span>
        </span>

        <span class="text-gray-600 block md:inline">
          es el indicador temprano de todos estos problemas
        </span>
      </p>
    </div>
  </div>
</section>

<style>
  /* Animación de entrada con fade */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  /* Animación de pulso lento para el hover */
  @keyframes pingSlow {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    50% {
      transform: scale(1.1);
      opacity: 0.3;
    }
    100% {
      transform: scale(1.2);
      opacity: 0;
    }
  }

  .animate-ping-slow {
    animation: pingSlow 2s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  /* Animación de flotación continua */
  @keyframes float {
    0%,
    100% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .group:hover .relative > div {
    animation: float 2s ease-in-out infinite;
  }

  /* Efecto de brillo en el texto al hacer hover */
  .group:hover h3 {
    text-shadow: 0 0 20px rgba(30, 58, 138, 0.3);
  }
</style>
