---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsappButton from '../components/WhatsappButton.astro';
---

<Layout title="DOMIND | Nosotros">
  <Navbar />
  <WhatsappButton />
  
<main class="pt-24">    <!-- Hero Section -->
    <section class="relative h-[500px] bg-gradient-to-br from-blue-900 via-indigo-900 to-blue-800 overflow-hidden">
      <div class="absolute inset-0 bg-black/30"></div>
      <img 
        src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1920&q=80" 
        alt="Equipo DOMIND" 
        class="absolute inset-0 w-full h-full object-cover mix-blend-overlay opacity-40"
      />
      
      <!-- Animated background elements -->
      <div class="absolute top-10 left-10 w-72 h-72 bg-blue-400/20 rounded-full blur-3xl animate-blob"></div>
      <div class="absolute bottom-10 right-10 w-96 h-96 bg-purple-400/20 rounded-full blur-3xl animate-blob animation-delay-2000"></div>
      
      <div class="relative h-full flex items-center justify-center text-center px-4">
        <div class="max-w-4xl mx-auto">
          <div class="inline-block mb-4 px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full border border-white/30">
            <span class="text-blue-200 font-semibold">Más de 25 años acompañando procesos de cambio organizacional</span>
          </div>
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white mb-6 animate-fade-in-up">
             Transformación Organizacional a través del Diálogo Estratégico
          </h1>
          <p class="text-xl sm:text-2xl text-blue-100 max-w-3xl mx-auto animate-fade-in-up animation-delay-200">
Ayudamos a las organizaciones a comprender sus desafíos, alinear a sus equipos y generar cambios sostenibles mediante diagnósticos organizacionales, alineación estratégica y estrategias basadas en comportamiento.
          </p>
        </div>
      </div>

      <!-- Wave divider -->
      <div class="absolute bottom-0 left-0 right-0">
        <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
          <path d="M0 0L60 10C120 20 240 40 360 46.7C480 53 600 47 720 43.3C840 40 960 40 1080 46.7C1200 53 1320 67 1380 73.3L1440 80V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0V0Z" fill="white"/>
        </svg>
      </div>
    </section>

    <!-- Mission & Vision -->
    <section class="py-16 md:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-12">
          <!-- Mission -->
          <div class="animate-fade-in-up">
            <div class="w-16 h-16 bg-gradient-to-br from-blue-900 to-blue-700 rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
              Nuestra Misión
            </h2>
            <p class="text-lg text-gray-700 leading-relaxed mb-6">
              Transformar organizaciones mediante diagnósticos precisos y soluciones estratégicas que mejoren el clima laboral, fortalezcan el liderazgo y promuevan el bienestar integral de los colaboradores.
            </p>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-green-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-700">Resultados medibles y sostenibles</span>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-green-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-700">Enfoque basado en evidencia científica</span>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-green-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-gray-700">Compromiso con el desarrollo humano</span>
              </div>
            </div>
          </div>

          <!-- Vision -->
          <div class="animate-fade-in-up animation-delay-200">
            <div class="w-16 h-16 bg-gradient-to-br from-purple-600 to-purple-800 rounded-2xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
            </div>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
              Nuestra Visión
            </h2>
            <p class="text-lg text-gray-700 leading-relaxed mb-6">
              Ser la firma líder en desarrollo organizacional en Latinoamérica, reconocida por nuestra excelencia en la creación de ambientes laborales saludables, seguros y productivos que impulsen el éxito organizacional.
            </p>
            <div class="space-y-3">
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-purple-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"/>
                </svg>
                <span class="text-gray-700">Innovación continua en metodologías</span>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-purple-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"/>
                </svg>
                <span class="text-gray-700">Impacto social positivo y duradero</span>
              </div>
              <div class="flex items-start gap-3">
                <svg class="w-6 h-6 text-purple-600 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"/>
                </svg>
                <span class="text-gray-700">Referente en buenas prácticas laborales</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="py-16 md:py-24 bg-gradient-to-br from-blue-900 to-indigo-900 relative overflow-hidden">
      <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-white mb-4 animate-fade-in-up">
            Nuestro Impacto en Números
          </h2>
          <p class="text-xl text-blue-200 animate-fade-in-up animation-delay-200">
            Resultados que respaldan nuestra experiencia
          </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          <div class="text-center animate-fade-in-up" style="animation-delay: 0.1s;">
            <div class="text-5xl md:text-6xl font-bold text-white mb-2">25+</div>
            <div class="text-blue-200 font-medium">Años de experiencia</div>
          </div>
          <div class="text-center animate-fade-in-up" style="animation-delay: 0.2s;">
            <div class="text-5xl md:text-6xl font-bold text-white mb-2">500+</div>
            <div class="text-blue-200 font-medium">Organizaciones asesoradas</div>
          </div>
          <div class="text-center animate-fade-in-up" style="animation-delay: 0.3s;">
            <div class="text-5xl md:text-6xl font-bold text-white mb-2">50K+</div>
            <div class="text-blue-200 font-medium">Profesionales capacitados</div>
          </div>
          <div class="text-center animate-fade-in-up" style="animation-delay: 0.4s;">
            <div class="text-5xl md:text-6xl font-bold text-white mb-2">95%</div>
            <div class="text-blue-200 font-medium">Satisfacción de clientes</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Our Values -->
    <section class="py-16 md:py-24 bg-gradient-to-b from-white to-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 animate-fade-in-up">
            Nuestros Valores
          </h2>
          <div class="flex justify-center mb-6">
            <div class="w-24 h-1 bg-gradient-to-r from-transparent via-blue-900 to-transparent"></div>
          </div>
          <p class="text-lg text-gray-600 max-w-3xl mx-auto animate-fade-in-up animation-delay-200">
            Los principios que guían cada acción y decisión en DOMIND
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- Value 1 -->
          <div class="bg-white rounded-2xl shadow-lg p-8 hover:shadow-xl transition-all duration-300 transform hover:scale-105 animate-fade-in-up" style="animation-delay: 0.1s;">
            <div class="w-14 h-14 bg-gradient-to-br from-blue-600 to-blue-800 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Integridad</h3>
            <p class="text-gray-600 leading-relaxed">
              Actuamos con honestidad, transparencia y ética profesional en cada interacción con nuestros clientes y colaboradores.
            </p>
          </div>

          <!-- Value 2 -->
          <div class="bg-white rounded-2xl shadow-lg p-8 hover:shadow-xl transition-all duration-300 transform hover:scale-105 animate-fade-in-up" style="animation-delay: 0.2s;">
            <div class="w-14 h-14 bg-gradient-to-br from-green-600 to-green-800 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Excelencia</h3>
            <p class="text-gray-600 leading-relaxed">
              Buscamos la mejora continua en nuestros servicios, metodologías y resultados para superar las expectativas de nuestros clientes.
            </p>
          </div>

          <!-- Value 3 -->
          <div class="bg-white rounded-2xl shadow-lg p-8 hover:shadow-xl transition-all duration-300 transform hover:scale-105 animate-fade-in-up" style="animation-delay: 0.3s;">
            <div class="w-14 h-14 bg-gradient-to-br from-purple-600 to-purple-800 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Colaboración</h3>
            <p class="text-gray-600 leading-relaxed">
              Trabajamos en equipo con nuestros clientes, construyendo relaciones de confianza y co-creando soluciones efectivas.
            </p>
          </div>

          <!-- Value 4 -->
          <div class="bg-white rounded-2xl shadow-lg p-8 hover:shadow-xl transition-all duration-300 transform hover:scale-105 animate-fade-in-up" style="animation-delay: 0.4s;">
            <div class="w-14 h-14 bg-gradient-to-br from-orange-600 to-orange-800 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Innovación</h3>
            <p class="text-gray-600 leading-relaxed">
              Adoptamos nuevas tecnologías y metodologías para ofrecer soluciones creativas y efectivas a los desafíos organizacionales.
            </p>
          </div>

          <!-- Value 5 -->
          <div class="bg-white rounded-2xl shadow-lg p-8 hover:shadow-xl transition-all duration-300 transform hover:scale-105 animate-fade-in-up" style="animation-delay: 0.5s;">
            <div class="w-14 h-14 bg-gradient-to-br from-red-600 to-red-800 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Empatía</h3>
            <p class="text-gray-600 leading-relaxed">
              Comprendemos las necesidades y desafíos únicos de cada organización, adaptando nuestros servicios a su contexto específico.
            </p>
          </div>

          <!-- Value 6 -->
          <div class="bg-white rounded-2xl shadow-lg p-8 hover:shadow-xl transition-all duration-300 transform hover:scale-105 animate-fade-in-up" style="animation-delay: 0.6s;">
            <div class="w-14 h-14 bg-gradient-to-br from-indigo-600 to-indigo-800 rounded-xl flex items-center justify-center mb-6">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-3">Compromiso</h3>
            <p class="text-gray-600 leading-relaxed">
              Nos dedicamos completamente al éxito de nuestros clientes, acompañándolos en cada etapa de su transformación organizacional.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Team Section -->
    <section class="py-16 md:py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 animate-fade-in-up">
            Nuestro Equipo
          </h2>
          <div class="flex justify-center mb-6">
            <div class="w-24 h-1 bg-gradient-to-r from-transparent via-blue-900 to-transparent"></div>
          </div>
          <p class="text-lg text-gray-600 max-w-3xl mx-auto animate-fade-in-up animation-delay-200">
            Profesionales altamente capacitados y comprometidos con tu éxito
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- Team Member 1 -->
          <div class="text-center group animate-fade-in-up" style="animation-delay: 0.1s;">
            <div class="relative w-48 h-48 mx-auto mb-6 rounded-2xl overflow-hidden shadow-xl">
              <div class="absolute inset-0 bg-gradient-to-br from-blue-900 to-blue-700 flex items-center justify-center text-white text-6xl font-bold">
                DR
              </div>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Dr. José Luis Calderón Mafud</h3>
            <p class="text-blue-900 font-semibold mb-3">Director General & Fundador</p>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">
              Psicólogo Organizacional certificado por ICOH-OMS con más de 25 años de experiencia en transformación organizacional.
            </p>
            <a href="https://www.linkedin.com/in/domind/" target="_blank" class="inline-flex items-center gap-2 text-blue-900 hover:text-blue-700 transition-colors">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
              Ver perfil
            </a>
          </div>

          <!-- Team Member 2 -->
          <div class="text-center group animate-fade-in-up" style="animation-delay: 0.2s;">
            <div class="relative w-48 h-48 mx-auto mb-6 rounded-2xl overflow-hidden shadow-xl">
              <div class="absolute inset-0 bg-gradient-to-br from-purple-600 to-purple-800 flex items-center justify-center text-white text-6xl font-bold">
                ML
              </div>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Mtra. Laura Méndez</h3>
            <p class="text-blue-900 font-semibold mb-3">Jr. de Consultoría</p>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">
              Especialista en clima organizacional y gestión del cambio con 15 años de experiencia en empresas multinacionales.
            </p>
          </div>

          <!-- Team Member 3 -->
          <div class="text-center group animate-fade-in-up" style="animation-delay: 0.3s;">
            <div class="relative w-48 h-48 mx-auto mb-6 rounded-2xl overflow-hidden shadow-xl">
              <div class="absolute inset-0 bg-gradient-to-br from-green-600 to-green-800 flex items-center justify-center text-white text-6xl font-bold">
                CS
              </div>
            </div>
            <h3 class="text-xl font-bold text-gray-900 mb-2">Dr. Carlos Sánchez</h3>
            <p class="text-blue-900 font-semibold mb-3">Jr. de Investigación</p>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">
              Doctor en Psicología del Trabajo enfocado en riesgos psicosociales y seguridad laboral con múltiples publicaciones académicas.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-16 md:py-24 bg-gradient-to-br from-blue-900 to-indigo-900 relative overflow-hidden">
      <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6 animate-fade-in-up">
          ¿Listo para Transformar tu Organización?
        </h2>
        <p class="text-xl text-blue-100 mb-8 animate-fade-in-up animation-delay-200">
          Únete a las más de 500 organizaciones que han confiado en nosotros para mejorar su clima laboral y productividad
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in-up animation-delay-400">
          
          <a  href="/diagnostico"
            class="inline-block px-8 py-4 bg-white text-blue-900 font-semibold rounded-xl shadow-xl hover:shadow-2xl transition-all duration-200 transform hover:scale-105"
          >
            Realizar Diagnóstico Gratuito
          </a>
          
           <a href="mailto:contacto@domind.com"
            class="inline-block px-8 py-4 bg-blue-800 hover:bg-blue-700 text-white font-semibold rounded-xl transition-all duration-200 border-2 border-white/30"
          >
            Contactar al Equipo
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .bg-grid-pattern {
    background-image: 
