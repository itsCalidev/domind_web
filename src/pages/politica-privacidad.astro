---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsappButton from '../components/WhatsappButton.astro';
---

<Layout title="DOMIND | Política de Privacidad">
  <Navbar />
  <WhatsappButton />
  
  <main class="pt-24">
    <!-- Hero Section -->
    <section class="relative h-[300px] bg-gradient-to-br from-gray-800 to-gray-900 overflow-hidden">
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
      
      <div class="relative h-full flex items-center justify-center text-center px-4">
        <div class="max-w-4xl mx-auto">
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-white mb-4 animate-fade-in-up">
            Política de Privacidad
          </h1>
          <p class="text-lg sm:text-xl text-gray-300 animate-fade-in-up animation-delay-200">
            Última actualización: Enero 2026
          </p>
        </div>
      </div>
    </section>

    <!-- Content -->
    <section class="py-16 md:py-24 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="prose prose-lg max-w-none">
          
          <!-- Introducción -->
          <div class="mb-12 animate-fade-in-up">
            <p class="text-lg text-gray-700 leading-relaxed text-justify">
              En DOMIND (en adelante, "nosotros", "nuestro" o "la Empresa"), valoramos y respetamos la privacidad de nuestros clientes y usuarios. Esta Política de Privacidad describe cómo recopilamos, usamos, protegemos y compartimos la información personal que nos proporcionas al utilizar nuestros servicios de diagnóstico organizacional, workshops y consultoría
            </p>
          </div>

          <!-- Section 1 -->
          <div class="mb-12 animate-fade-in-up" style="animation-delay: 0.1s;">
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
              <span class="flex items-center justify-center w-10 h-10 bg-blue-900 text-white rounded-lg text-lg font-bold">1</span>
              Información que Recopilamos
            </h2>
            
            <div class="bg-gray-50 rounded-xl p-6 mb-6 border border-gray-200">
              <h3 class="text-xl font-semibold text-gray-900 mb-4">1.1 Información Proporcionada Directamente</h3>
              <ul class="space-y-3 text-gray-700">
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-blue-900 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span><strong>Datos de contacto:</strong> Nombre completo, correo electrónico, número telefónico, cargo y nombre de la organización.</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-blue-900 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span><strong>Respuestas de diagnóstico:</strong> Información proporcionada en cuestionarios sobre clima laboral, seguridad y bienestar organizacional.</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-blue-900 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span><strong>Información comercial:</strong> Datos necesarios para la contratación de servicios y facturación.</span>
                </li>
              </ul>
            </div>

            <div class="bg-gray-50 rounded-xl p-6 border border-gray-200">
              <h3 class="text-xl font-semibold text-gray-900 mb-4">1.2 Información Recopilada Automáticamente</h3>
              <ul class="space-y-3 text-gray-700">
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-blue-900 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span><strong>Datos de navegación:</strong> Dirección IP, tipo de navegador, páginas visitadas, tiempo de permanencia.</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg class="w-6 h-6 text-blue-900 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span><strong>Cookies y tecnologías similares:</strong> Para mejorar la experiencia del usuario y analizar el uso del sitio.</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- Section 2 -->
          <div class="mb-12 animate-fade-in-up" style="animation-delay: 0.2s;">
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
              <span class="flex items-center justify-center w-10 h-10 bg-blue-900 text-white rounded-lg text-lg font-bold">2</span>
              Uso de la Información
            </h2>
            
            <div class="bg-blue-50 rounded-xl p-6 border border-blue-200">
              <p class="text-gray-700 mb-4">Utilizamos la información recopilada para:</p>
              <ul class="space-y-2 text-gray-700">
                <li class="flex items-start gap-2">
                  <span class="text-blue-900">•</span>
                  <span>Proporcionar, mantener y mejorar nuestros servicios de diagnóstico y consultoría.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-blue-900">•</span>
                  <span>Generar reportes personalizados sobre el clima laboral y riesgos organizacionales.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-blue-900">•</span>
                  <span>Comunicarnos contigo sobre nuestros servicios, workshops y actualizaciones.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-blue-900">•</span>
                  <span>Cumplir con obligaciones legales y regulatorias aplicables.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-blue-900">•</span>
                  <span>Realizar análisis estadísticos agregados y anónimos para mejorar nuestros servicios.</span>
                </li>
              </ul>
            </div>
          </div>

          <!-- Section 3 -->
          <div class="mb-12 animate-fade-in-up" style="animation-delay: 0.3s;">
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
              <span class="flex items-center justify-center w-10 h-10 bg-blue-900 text-white rounded-lg text-lg font-bold">3</span>
              Protección de Datos
            </h2>
            
            <p class="text-gray-700 mb-6">
              Implementamos medidas de seguridad técnicas, administrativas y físicas para proteger tu información personal contra acceso no autorizado, pérdida, alteración o divulgación:
            </p>

            <div class="grid md:grid-cols-2 gap-4">
              <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                <div class="flex items-center gap-3 mb-2">
                  <svg class="w-6 h-6 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                  </svg>
                  <h3 class="font-semibold text-gray-900">Encriptación</h3>
                </div>
                <p class="text-sm text-gray-600">Uso de SSL/TLS para transmisión de datos</p>
              </div>

              <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                <div class="flex items-center gap-3 mb-2">
                  <svg class="w-6 h-6 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                  </svg>
                  <h3 class="font-semibold text-gray-900">Acceso Restringido</h3>
                </div>
                <p class="text-sm text-gray-600">Solo personal autorizado accede a datos personales</p>
              </div>

              <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                <div class="flex items-center gap-3 mb-2">
                  <svg class="w-6 h-6 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>
                  </svg>
                  <h3 class="font-semibold text-gray-900">Servidores Seguros</h3>
                </div>
                <p class="text-sm text-gray-600">Almacenamiento en infraestructura certificada</p>
              </div>

              <div class="bg-gray-50 rounded-lg p-4 border border-gray-200">
                <div class="flex items-center gap-3 mb-2">
                  <svg class="w-6 h-6 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                  </svg>
                  <h3 class="font-semibold text-gray-900">Auditorías</h3>
                </div>
                <p class="text-sm text-gray-600">Revisiones periódicas de seguridad</p>
              </div>
            </div>
          </div>

          <!-- Section 4 -->
          <div class="mb-12 animate-fade-in-up" style="animation-delay: 0.4s;">
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
              <span class="flex items-center justify-center w-10 h-10 bg-blue-900 text-white rounded-lg text-lg font-bold">4</span>
              Tus Derechos
            </h2>
            
            <div class="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-6 border border-blue-200">
              <p class="text-gray-700 mb-4 font-semibold">Tienes derecho a:</p>
              <div class="grid md:grid-cols-2 gap-4">
                <div class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-blue-900 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700"><strong>Acceder</strong> a tus datos personales</span>
                </div>
                <div class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-blue-900 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700"><strong>Rectificar</strong> información incorrecta</span>
                </div>
                <div class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-blue-900 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700"><strong>Cancelar</strong> tu registro</span>
                </div>
                <div class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-blue-900 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700"><strong>Oponerte</strong> al procesamiento</span>
                </div>
                <div class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-blue-900 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700"><strong>Solicitar</strong> portabilidad de datos</span>
                </div>
                <div class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-blue-900 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-gray-700"><strong>Limitar</strong> el uso de tus datos</span>
                </div>
              </div>

              <div class="mt-6 pt-6 border-t border-blue-200">
                <p class="text-gray-700">
                  Para ejercer estos derechos, contáctanos en: 
                  <a href="mailto:info@domind.com" class="text-blue-900 font-semibold hover:underline">info@domind.com</a>
                </p>
              </div>
            </div>
          </div>

          <!-- Section 5 -->
          <!-- <div class="mb-12 animate-fade-in-up" style="animation-delay: 0.5s;">
            <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6 flex items-center gap-3">
              <span class="flex items-center justify-center w-10 h-10 bg-blue-900 text-white rounded-lg text-lg font-bold">5</span>
              Contacto
            </h2>
            
            <div class="bg-gray-900 text-white rounded-xl p-8">
              <p class="mb-6">
                Si tienes preguntas, comentarios o inquietudes sobre esta Política de Privacidad, puedes contactarnos:
              </p>
              <div class="grid md:grid-cols-2 gap-6">
